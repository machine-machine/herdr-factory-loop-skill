# Simple by default: name, state, progress, the worker's sentence. HERD_BOARD_DETAIL=1 adds model·effort tags,
# ⇄ file overlaps, PR refs @sha7, the merge word and one line per Workflow run (operator 26.10.: too crowded).
DETAIL = os.environ.get("HERD_BOARD_DETAIL", "").lower() in ("1", "true", "yes", "ja")
