def t(key, **kw):
    return STRINGS[LANG][key].format(**kw)


def field(st, en, de):
    """A status.json field under its English or German key."""
    return st.get(en, st.get(de))


def as_list(v):
    """An event field that should be a list: a lone string or number becomes a one-item list, None nothing.
    Events are written by herd-phase from LLM-typed --field values; a wrong shape must not end the board."""
    if v is None or v == "":
        return []
    if isinstance(v, (list, tuple)):
        return [x for x in v if x is not None]
    return [v]


TEXT_KEYS = ("sentence", "satz", "missing", "fehlt", "short", "kurz", "pr")
NUM_KEYS = ("step", "schritt", "of", "von")


def read_status(path):
    """A worker's <slice>.status.json, bent into the contract: anything but an object is {}, a list in a text field
    becomes "a, b", other values become text; step/of stay numbers (a digit string counts). Workers write this file by
    hand, so a stray list or null must never take the board down."""
    try:
        st = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(st, dict):
        return {}
    out = {}
    for k, v in st.items():
        if k in NUM_KEYS:
            v = int(v) if isinstance(v, str) and v.strip().isdigit() else v
            out[k] = v if isinstance(v, int) and not isinstance(v, bool) else None
        elif k in TEXT_KEYS:
            out[k] = ", ".join(str(x) for x in v) if isinstance(v, list) else "" if v is None else str(v)
        else:
            out[k] = v
    return out


# Only the 16 theme colours (follow the terminal's palette), one meaning each, never meaning by colour alone (the icons
# stay): red = needs me, yellow = waiting/attention, green = done/ok, cyan = herd worker running, blue = numbers and
# progress, magenta = my subagents, review running and references (PR #, commit). ORANGE (fix round, findings) is
# bright red, the slot palettes like Solarized fill with orange. Dim = secondary. NO_COLOR (no-color.org) turns it off.
_C = not os.environ.get("NO_COLOR")
DIM, BOLD, ITAL, GREEN, RED, CYAN, YEL, BLUE, MAG, ORANGE, RST = (
    ("\033[2m", "\033[1m", "\033[3m", "\033[32m", "\033[31m", "\033[36m", "\033[33m", "\033[34m", "\033[35m",
     "\033[91m", "\033[0m") if _C else ("",) * 11)
# words and references that carry their own colour wherever they appear
TOKENS = [
    (re.compile(r"(?<![\w#])(?:PR\s)?#\d+\b|\b[a-z][\w-]{1,20}\s?#\d+(?:@[0-9a-f]{7,40})?\b"), MAG),
    (re.compile(r"\b(?=[0-9a-f]*[a-f])(?=[0-9a-f]*\d)[0-9a-f]{7,12}\b"), YEL),
    (re.compile(r"\b(?:done|merged|green|passed|ok|fertig|gemergt|grün|bestanden)\b", re.I), GREEN),
    (re.compile(r"\b(?:blocked|failed|errors?|red|aborted|blockiert|Fehler\w*|rot|fehlgeschlagen|abgebrochen)\b",
                re.I), RED),
    (re.compile(r"\b\d+(?:[.,]\d+)?\s?(?:%|GB|MB|ha|min|h|Min|Std|tests?|Tests?)\b|\b\d+/\d+\b"), BLUE),
]
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def clip(line, w):
    """`line` cut to `w` terminal columns, colour codes kept and not counted, wide glyphs (emoji, CJK) as two. The
    last guard before painting: a line the terminal wraps itself makes the frame taller than the panel, the panel
    scrolls on every repaint and the header piles up."""
    out, col, i = [], 0, 0
    for m in ANSI.finditer(line + "\x1b[0m"):
        for ch in line[i:m.start()]:
            cw = 0 if unicodedata.combining(ch) else 2 if unicodedata.east_asian_width(ch) in "WF" else 1
            if col + cw > w:
                return "".join(out) + RST
            out.append(ch)
            col += cw
        if m.start() < len(line):  # the appended reset only ends the scan
            out.append(m.group(0))
        i = m.end()
    return "".join(out)


def paint(text, base=""):
    """`text` in `base` with the TOKENS coloured; after each token the base style comes back."""
    if not _C or not text:
        return text
    spans = []
    for rx, col in TOKENS:
        for m in rx.finditer(text):
            if not any(a < m.end() and m.start() < b for a, b, _ in spans):
                spans.append((m.start(), m.end(), col))
    out, pos = base, 0
    for a, b, col in sorted(spans):
        out += text[pos:a] + RST + col + text[a:b] + RST + base
        pos = b
    return out + text[pos:] + (RST if base else "")


STILL_MIN = 10          # no transcript write and no process for this long -> "still"

# what a process in the worktree means, in plain words (first match wins); tests and builds get the ⧗ icon
PROCS = [
    (r"pytest|vitest|jest|go test|cargo test", t("tests")),
    (r"next build|npm run build|tsc --noEmit|next lint|npm run lint", t("build")),
    (r"playwright|chrom", t("shots")),
    (r"next dev|next-server|vite", t("devsrv")),
    (r"uvicorn|gunicorn", t("srv")),
    (r"npm ci|npm install|uv sync|uv pip|pip install", t("deps")),
    (r"git push|gh pr", t("push")),
]
LONG_RUNS = {t("tests"), t("build")}


def herdr_agents():
    try:
        r = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, timeout=10)
        return {a["pane_id"]: a for a in json.loads(r.stdout)["result"]["agents"]}
    except Exception:
        return {}


def procs_in(slice_name, extra=()):
    """Plain-word activities of processes whose cwd lies in any worktree of this slice."""
    roots = set(glob.glob(os.path.expanduser(f"~/.herdr/worktrees/*/{slice_name}")))
    roots |= {os.path.expanduser(str(p)).rstrip("/") for p in extra if p}
    if not roots:
        return []
    found = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
            if not any(cwd == r or cwd.startswith(r + "/") for r in roots):
                continue
            args = open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
            start = os.stat(f"/proc/{pid}").st_mtime
        except OSError:
            continue
        if "claude" in args.split(" ")[0] or re.search(r"mcp|hermes", args):
            continue  # Claude itself and its tool servers (playwright-mcp) are not activities
        for rank, (pat, words) in enumerate(PROCS):
            if re.search(pat, args):
                found.append((rank, words, start))
                break
    best = {}
    for rank, words, start in found:  # oldest process per activity, most telling activity first
        r0, s0 = best.get(words, (rank, start))
        best[words] = (rank, min(start, s0))
    return [(w, st) for w, (r, st) in sorted(best.items(), key=lambda kv: kv[1][0])]


def claude_project_dir(cwd):
    if he:
        return he.claude_project_dir(cwd)
    return os.path.expanduser("~/.claude/projects/" + re.sub(r"[^A-Za-z0-9]", "-", cwd))  # board without its core


def transcript_age(cwd):
    d = claude_project_dir(cwd)
    files = glob.glob(os.path.join(d, "*.jsonl"))
    return (time.time() - max(os.path.getmtime(f) for f in files)) / 60 if files else None


def read_list(path):
    try:
        return [l.strip() for l in open(path, encoding="utf-8") if l.strip() and not l.startswith("#")]
    except OSError:
        return []


def kurz(st):
    """3-6 words: the worker's own short line, else the first clause of its sentence."""
    k = field(st, "short", "kurz") or re.split(r"[:;,–—(]", field(st, "sentence", "satz") or "")[0]
    return " ".join(k.split())


def tool_words(c):
    """One tool call in a few plain words."""
    inp, name = c.get("input") or {}, c.get("name", "")
    f = os.path.basename(inp.get("file_path", "") or inp.get("path", ""))
    p = inp.get("pattern", "")[:30]
    if inp.get("description"):
        return ("🤖 " if name in ("Agent", "Task") else "") + inp["description"]
    return {"Read": t("read", f=f), "Edit": t("edit", f=f), "Write": t("write", f=f), "Grep": t("grep", p=p),
            "Glob": t("glob", p=p), "SendMessage": t("send"),
            "Bash": "",  # a raw command line says nothing at a glance; only described ones are shown
            "Monitor": t("monitor")}.get(name, name)


def recent_actions(jsonl, k):
    """The last k steps of a transcript, oldest first: (minutes ago, text). Text replies start with ›."""
    if not jsonl or k <= 0:
        return []
    try:
        with open(jsonl, "rb") as f:
            f.seek(max(0, os.path.getsize(jsonl) - 4194304))  # tool results (screenshots) are large
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return []
    out = []
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        msg = d.get("message") or {}
        if d.get("type") != "assistant" or not isinstance(msg.get("content"), list):
            continue
        try:
            ago = (time.time() - calendar.timegm(time.strptime(d["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))) / 60
        except (KeyError, ValueError):
            ago = 0
        for c in reversed(msg["content"]):
            if c.get("type") == "tool_use" and c.get("name") not in ("TodoWrite", "ToolSearch") and tool_words(c):
                out.append((ago, tool_words(c)))
            elif c.get("type") == "text" and c.get("text", "").strip():
                out.append((ago, "› " + " ".join(c["text"].split())))
            if len(out) >= k:
                return out[::-1]
    return out[::-1]


def last_action(jsonl):
    acts = recent_actions(jsonl, 1)
    return acts[0][1] if acts else ""


def newest_jsonl(cwd):
    files = glob.glob(os.path.join(claude_project_dir(cwd), "*.jsonl"))
    return max(files, key=os.path.getmtime) if files else None


# ---------------------------------------------------------------------------------------------------------------
# The orchestrator's own subagents and Workflow runs
# ---------------------------------------------------------------------------------------------------------------

WF_DONE_KEEP_MIN = 10  # a workflow without running agents stays registered this long (gaps between phases)
WF_STALE_MIN = 30      # a run with no movement for this long was stopped
AGENT_DEAD_MIN = 120   # a subagent transcript not written for this long belongs to a dead session: unregister it


def workflow_rows(reg, label, wdir):
    """Rows for a Workflow run: one header line with the counts; an agent gets its own row only when it is still
    (⚠). Three review loops with a step feed per agent crowded the Working lane — their state is in Ready to merge."""
    try:
        events = [json.loads(l) for l in open(os.path.join(wdir, "journal.jsonl"), encoding="utf-8") if l.strip()]
        jage = (time.time() - os.path.getmtime(os.path.join(wdir, "journal.jsonl"))) / 60
    except (OSError, ValueError):
        return []
    events = [e for e in events if isinstance(e, dict)]
    started = {e["agentId"]: e.get("label") or "agent" for e in events
               if e.get("type") == "started" and e.get("agentId")}
    done = {e["agentId"] for e in events if e.get("type") == "result" and e.get("agentId")}
    running = [a for a in started if a not in done]
    # a stopped run (TaskStop, session end) never writes "result": when neither the journal nor any agent
    # transcript moved for WF_STALE_MIN, the run is over — drop it instead of showing "still" forever
    try:
        newest = max(os.path.getmtime(f) for f in glob.glob(os.path.join(wdir, "*.jsonl")))
    except ValueError:
        newest = 0
    if (running and (time.time() - newest) / 60 > WF_STALE_MIN) or (not running and jage > WF_DONE_KEEP_MIN):
        try:
            os.unlink(reg)
        except OSError:
            pass
        return []
    # all rows rank 2 and a shared sort key, so the run stays one block: header first, then its agents
    rows = [(2, label, "▸", MAG, "", t("wf", r=len(running), d=len(done)), "", {"sort": label})]
    for aid, alabel in started.items():
        jsonl = os.path.join(wdir, f"agent-{aid}.jsonl")
        try:
            age = (time.time() - os.path.getmtime(jsonl)) / 60
        except OSError:
            continue
        tail = f"{int(age)}m" if age >= 1 else ""
        name = f"  {alabel}"[:40]
        d = {"jsonl": jsonl, "sort": f"{label}\x01{alabel}"}
        # still for a while = ⚠; no move for WF_STALE_MIN = an agent of an interrupted session that a resumed run
        # replaced with a new one (its journal entry never gets a result) — dead, not stuck: leave it out
        if aid not in done and STILL_MIN <= age < WF_STALE_MIN:
            rows.append((2, name, "⚠", RED, "", f"{t('still')} {tail}", "", d))
    return rows


def discover_workflows(anchor, agents):
    """Register the anchor session's own Workflow runs without a hook (hooks load only at session start): the
    Claude session id of the anchor pane leads to ~/.claude/projects/*/<session>/subagents/workflows/wf_*/."""
    sess = ((agents.get(anchor) or {}).get("agent_session") or {}).get("value")
    if not sess:
        return
    reg = os.path.join(CACHE, f"{anchor.replace(':', '_')}.agents")
    for wdir in glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sess}/subagents/workflows/wf_*")):
        wid = os.path.basename(wdir)
        try:
            if (time.time() - os.path.getmtime(os.path.join(wdir, "journal.jsonl"))) / 60 > WF_DONE_KEEP_MIN:
                continue
        except OSError:
            continue
        if os.path.exists(os.path.join(reg, wid)):
            continue
        scripts = glob.glob(os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(wdir))), "workflows",
                                         "scripts", f"*-{wid}.js"))
        name = os.path.basename(scripts[0])[:-len(f"-{wid}.js")] if scripts else wid
        os.makedirs(reg, exist_ok=True)
        with open(os.path.join(reg, wid), "w", encoding="utf-8") as f:
            f.write(f"wf {name}"[:40] + f"\n{wdir}\n")


def agent_rows(anchor, agents=None):
    rows = []
    if agents is not None:
        discover_workflows(anchor, agents)
    for reg in glob.glob(os.path.join(CACHE, f"{anchor.replace(':', '_')}.agents", "*")):
        try:
            label, jsonl = open(reg, encoding="utf-8").read().split("\n", 1)
            jsonl = jsonl.strip()
            if os.path.isdir(jsonl):
                # simple view: a review run already shows as "Review läuft" under Ready to merge; the call still
                # runs, so a stopped run's registration is dropped in both views
                wf = workflow_rows(reg, label, jsonl)
                rows += wf if DETAIL else []
                continue
            meta = json.load(open(jsonl[:-6] + ".meta.json")) if os.path.exists(jsonl[:-6] + ".meta.json") else {}
            meta = meta if isinstance(meta, dict) else {}
            age = (time.time() - os.path.getmtime(jsonl)) / 60
        except (OSError, ValueError):
            continue
        tail = f"{int(age)}m" if age >= 1 else ""
        detail = {"jsonl": jsonl}
        if meta.get("finished"):
            if age > AGENT_DONE_KEEP_MIN:
                os.unlink(reg)
                continue
            rows.append((1, label, "✓", GREEN, "", t("done"), "", detail))
        elif age > AGENT_DEAD_MIN:
            # a subagent of an ended or interrupted session never writes "finished": its transcript just stops.
            # Drop the registration instead of showing "still 9469m" forever (WF_STALE_MIN does this for runs)
            try:
                os.unlink(reg)
            except OSError:
                pass
            continue
        elif age >= STILL_MIN:
            rows.append((0, label, "⚠", RED, "", f"{t('still')} {tail}", "", detail))
        else:
            rows.append((2, label, "◆", MAG, "", last_action(jsonl) or t("working"), tail, detail))
    return rows


# ---------------------------------------------------------------------------------------------------------------
# GitHub (cached; every call degrades to "unknown" offline)
# ---------------------------------------------------------------------------------------------------------------

PR_STATE = {}           # key -> (state, head sha, checked_at); GitHub is asked at most every PR_CHECK_S per PR
PR_CHECK_S = 45
MAIN_HEAD = {}          # key -> (sha, checked_at)
MAIN_CHECK_S = 60


def slug_for(repo):
    """"owner/name" for a short name, a bare name under HERD_BOARD_ORG or an owner/name; "" = let gh resolve it
    from the worktree's git remote."""
    v = REPOS.get(repo, repo or "")
    return v if "/" in v else f"{ORG}/{v}" if v and ORG else ""


def short_repo(repo):
    name = str(repo or "").split("/")[-1]
    return SHORT.get(name, name)


def pr_state(repo, n, cwd=None):
    """(state, head sha) of a PR, cached PR_CHECK_S seconds. `repo` is "owner/name", a bare name under
    HERD_BOARD_ORG, or empty — then gh resolves the repo from the git remote of `cwd` (the worker's worktree)."""
    slug = repo if "/" in (repo or "") else f"{ORG}/{repo}" if repo and ORG else ""
    key = (slug or cwd or repo, n)
    st, head, at = PR_STATE.get(key, (None, None, 0))
    if time.time() - at < PR_CHECK_S:
        return st, head
    if slug or (cwd and os.path.isdir(cwd)):
        try:
            r = subprocess.run(["gh", "pr", "view", str(n), *(["-R", slug] if slug else []), "--json",
                                "state,headRefOid", "-q", '.state + " " + .headRefOid'],
                               capture_output=True, text=True, timeout=8, cwd=None if slug else cwd)
            st, head = (r.stdout.split() + [None, None])[:2] if r.returncode == 0 and r.stdout.strip() else (st, head)
        except Exception:
            pass
    PR_STATE[key] = (st, head, time.time())
    return st, head


def main_head(slug, cwd=None):
    """sha of the default branch head of `slug` (or of the repo behind `cwd`), cached MAIN_CHECK_S; None = unknown."""
    key = slug or cwd
    if not key:
        return None
    sha, at = MAIN_HEAD.get(key, (None, 0))
    if time.time() - at < MAIN_CHECK_S:
        return sha
    if slug or (cwd and os.path.isdir(cwd)):
        try:
            r = subprocess.run(["gh", "api", f"repos/{slug or '{owner}/{repo}'}/commits/HEAD", "-q", ".sha"],
                               capture_output=True, text=True, timeout=8, cwd=None if slug else cwd)
            out = r.stdout.strip()
            sha = out if r.returncode == 0 and re.fullmatch(r"[0-9a-f]{7,40}", out) else sha
        except Exception:
            pass
    MAIN_HEAD[key] = (sha, time.time())
    return sha


MERGED = {"at": 0, "day": "", "prs": {}}   # repo short -> sorted PR numbers merged today, cached
MERGED_CHECK_S = 300   # the search API has a tight secondary rate limit; several boards may poll it
DAY_TZ = "Europe/Berlin"  # "today" starts at midnight here, whatever the machine's TZ is


def day_start():
    """(epoch of today's midnight in DAY_TZ, ISO stamp with offset for a GitHub search, date string)."""
    try:
        import datetime, zoneinfo
        now = datetime.datetime.now(zoneinfo.ZoneInfo(DAY_TZ))
        mid = now.replace(hour=0, minute=0, second=0, microsecond=0)
        return mid.timestamp(), mid.isoformat(timespec="seconds"), mid.strftime("%Y-%m-%d")
    except Exception:  # no tz database: local midnight
        lt = time.localtime()
        mid = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1))
        return mid, time.strftime("%Y-%m-%d", lt), time.strftime("%Y-%m-%d", lt)


def repo_label(repo):
    """Short repo name for the Merged today line: a HERD_BOARD_REPOS short name stays, otherwise the last part of
    a hyphenated name (gst-gen-api -> api, artenschutz-ingest -> ingest)."""
    name = str(repo or "").split("/")[-1]
    return name if name in REPOS else SHORT.get(name) or name.rsplit("-", 1)[-1] or name


def merged_today():
    """PRs merged today (since midnight DAY_TZ) under HERD_BOARD_ORG (plus HERD_BOARD_REPOS entries of other
    owners), by repo: {"api": [176, 177, …], "ui": [72, 73]}."""
    if not ORGS:
        return {}
    _, since, day = day_start()
    if MERGED["day"] == day and time.time() - MERGED["at"] < MERGED_CHECK_S:
        return MERGED["prs"]
    # one search per owner: mixing org: and repo: qualifiers in one query returned only one of the two sets
    queries = [f"org:{o}" for o in ORGS]
    outside = [v for v in REPOS.values() if "/" in v and v.split("/")[0] not in ORGS]
    if outside:
        queries.append(" ".join(f"repo:{v}" for v in outside))
    prs, ok = {}, False
    for q in queries:
        try:
            r = subprocess.run(["gh", "api", "-X", "GET", "search/issues", "-f",
                                f"q={q} is:pr is:merged merged:>={since}", "-f", "per_page=100", "--jq",
                                '.items[] | "\\(.repository_url | split("/") | last) \\(.number)"'],
                               capture_output=True, text=True, timeout=10)
        except Exception:
            continue
        if r.returncode == 0:
            ok = True
            for line in r.stdout.split("\n"):
                parts = line.split()
                if len(parts) == 2 and parts[1].isdigit():
                    prs.setdefault(short_repo(parts[0]), []).append(int(parts[1]))
    if ok:
        # union with what was already seen today: the search index sometimes returns a partial list
        if MERGED["day"] == day:
            for k, v in MERGED["prs"].items():
                prs.setdefault(k, []).extend(v)
        MERGED.update(prs={k: sorted(set(v)) for k, v in prs.items()}, day=day)
    MERGED["at"] = time.time()
    return MERGED["prs"]


# ---------------------------------------------------------------------------------------------------------------
# Computed facts from sibling tools: herd-limits (slots) and herd-clash (file overlap). Both optional.
# ---------------------------------------------------------------------------------------------------------------

TOOL_CACHE = {}         # (tool, herd) -> (at, value)
LIMITS_CHECK_S = 15
CLASH_CHECK_S = 30


def find_tool(name):
    """A sibling tool on PATH, else next to this script (with or without .sh/.py); None when absent."""
    hit = shutil.which(name)
    if hit:
        return hit
    for ext in ("", ".sh", ".py"):
        p = os.path.join(HERE, name + ext)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def _cached(key, ttl, fn):
    at, val = TOOL_CACHE.get(key, (0, None))
    if time.time() - at < ttl:
        return val
    val = fn()
    TOOL_CACHE[key] = (time.time(), val)
    return val


def _limits_env(herd):
    env = {}
    for l in read_list(os.path.join(herd, "limits.env")) if herd else []:
        m = re.match(r"(?:export\s+)?(HERD_\w+)=['\"]?([^'\"\s]*)", l)
        if m:
            env[m[1]] = m[2]
    return env


def parse_limits(text, rc, herd=None):
    """herd-limits output -> {"used", "max", "review", "ok", "reason"} (reason: slot|memory|load|None).
    Reads `herd-limits --json` (used/max/review/free_mb/min_free_mb/load/max_load/reasons) or its text line
    `slots used/max (k review), free N MB (min M), load L (max X)` + `no slot: <reasons>`. Exit 2 (cannot measure)
    is None. A refusal whose reason is not named is derived from the thresholds in the output, else from the
    defaults of docs §4 (HERD_MIN_FREE_MB 8000, HERD_MAX_LOAD cores×2.5; env and <herd>/limits.env win)."""
    if rc not in (0, 1):
        return None
    d = {}
    try:
        j = json.loads(text)
        d = j if isinstance(j, dict) else {}
    except ValueError:
        pass
    num = lambda v: float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else \
        float(v) if isinstance(v, str) and re.fullmatch(r"\d+(?:\.\d+)?", v.strip()) else None
    used = num(d.get("used", d.get("slots_used")))
    mx = num(d.get("max", d.get("slots_max")))
    review = num(d.get("review", d.get("review_slots")))
    free_mb = num(d.get("free_mb"))
    load = num(d.get("load"))
    min_free, max_load = num(d.get("min_free_mb")), num(d.get("max_load"))
    reasons = " ".join(str(r) for r in as_list(d.get("reasons"))) if d else \
        (re.search(r"no slot:(.*)", text) or [None, ""])[1]
    reason = d.get("reason") if d.get("reason") in ("slot", "memory", "load") else \
        "slot" if re.search(r"slots? used", reasons) else "memory" if re.search(r"\bMB\b", reasons) else \
        "load" if re.search(r"\bload\b", reasons) else None
    if not d:
        m = re.search(r"(\d+)\s*/\s*(\d+)", text)
        used, mx = (float(m[1]), float(m[2])) if m else (None, None)
        m = re.search(r"(\d+)\s*(?:review|Review)", text)
        review = float(m[1]) if m else None
        m = re.search(r"(\d+)\s*MB", text)
        free_mb = float(m[1]) if m else None
        m = re.search(r"\(min (\d+)\)", text)
        min_free = float(m[1]) if m else None
        m = re.search(r"\(max (\d+(?:\.\d+)?)\)", text)
        max_load = float(m[1]) if m else None
        m = re.search(r"(?:load|Last)\D{0,3}(\d+(?:\.\d+)?)", text)
        load = float(m[1]) if m else None
    if used is None or mx is None:
        return None
    ok = rc == 0
    if not ok and not reason:
        env = dict(_limits_env(herd), **{k: v for k, v in os.environ.items() if k.startswith("HERD_")})
        val = lambda k, dflt: num(env.get(k)) if num(env.get(k)) is not None else dflt
        min_free = min_free if min_free is not None else val("HERD_MIN_FREE_MB", 8000)
        max_load = max_load if max_load is not None else val("HERD_MAX_LOAD", (os.cpu_count() or 1) * 2.5)
        reason = "slot" if used >= mx else "memory" if free_mb is not None and free_mb < min_free else \
            "load" if load is not None and load >= max_load else "slot"
    return {"used": int(used), "max": int(mx), "review": None if review is None else int(review), "ok": ok,
            "reason": None if ok else reason}


def herd_limits(herd, anchor=""):
    """`herd-limits <herd> --json [--anchor A]`, cached LIMITS_CHECK_S; None when absent or unmeasurable."""
    tool = find_tool("herd-limits")
    if not tool:
        return None

    def ask():
        try:
            r = subprocess.run([tool, *([herd] if herd else []), "--json", *(["--anchor", anchor] if anchor else [])],
                               capture_output=True, text=True, timeout=8)
        except Exception:
            return None
        return parse_limits(r.stdout or "", r.returncode, herd)
    return _cached(("limits", herd), LIMITS_CHECK_S, ask)


def parse_clash(data):
    """herd-clash --json -> {slice: {other slices}}. Reads its `pairs` list ({"repo", "slices": [a, b], "files"});
    without one, any nested {"slices": [a, b, ...]} or {"a": .., "b": ..} object counts (anything else is ignored)."""
    pairs = []
    if isinstance(data, dict) and isinstance(data.get("pairs"), list):
        data = data["pairs"]

    def walk(x):
        if isinstance(x, dict):
            sl = x.get("slices", x.get("pair"))
            if isinstance(sl, list) and len([s for s in sl if isinstance(s, str)]) >= 2:
                pairs.append([s for s in sl if isinstance(s, str)])
            elif isinstance(x.get("a"), str) and isinstance(x.get("b"), str):
                pairs.append([x["a"], x["b"]])
            for v in x.values():
                if isinstance(v, (dict, list)):
                    walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)
    walk(data)
    out = {}
    for p in pairs:
        for s in p:
            out.setdefault(s, set()).update(o for o in p if o != s)
    return out


def herd_clash(herd):
    tool = find_tool("herd-clash")
    if not tool:
        return {}  # skipped: the tool is not installed

    def ask():
        try:
            r = subprocess.run([tool, herd, "--json"], capture_output=True, text=True, timeout=10)
            return parse_clash(json.loads(r.stdout)) if r.returncode == 0 and r.stdout.strip() else {}
        except Exception:
            return {}
    return _cached(("clash", herd), CLASH_CHECK_S, ask) or {}


# ---------------------------------------------------------------------------------------------------------------
# Cheap facts from the herd dir's own files (no git, no network): GO.md, reprobe logs, merge chains
# ---------------------------------------------------------------------------------------------------------------

GO_FILE = "GO.md"       # the user's words, one line per go: "… = MERGE-Wort für Welle 14 (a, b, c) …"
GO_TAIL = 60            # merge words are read from the last GO_TAIL lines only
UNITS_CHECK_S = 30
UNIT_PATTERNS = ("merge-*", "gv-runde-*", "recalc-*")   # systemd user units shown under "Chains & runs"
NO_WORD = re.compile(r"\bkein\w*\s+(?:ausdrückliches\s+)?merge-wort", re.I)
_FILE_CACHE = {}        # (kind, path) -> (mtime, value)


def _by_mtime(kind, path, fn):
    """fn(path) cached until the file's mtime changes; fn(None) when the file is missing."""
    try:
        mt = os.path.getmtime(path)
    except OSError:
        return fn(None)
    hit = _FILE_CACHE.get((kind, path))
    if hit and hit[0] == mt:
        return hit[1]
    val = fn(path)
    _FILE_CACHE[(kind, path)] = (mt, val)
    return val


def go_lines(herd):
    def load(p):
        if not p:
            return []
        try:
            return [l.rstrip("\n") for l in open(p, encoding="utf-8", errors="replace") if l.strip()]
        except OSError:
            return []
    return _by_mtime("go", os.path.join(herd, GO_FILE), load)


def has_go_file(herd):
    return os.path.isfile(os.path.join(herd, GO_FILE))


def merge_word_sentences(herd):
    """Sentences of the last GO_TAIL GO.md lines that give a merge word: they name "Merge-Wort"/"MERGE-Wort" and
    do not say "KEIN (ausdrückliches) Merge-Wort". A line is split at ". " and "; " first, so "MERGE-Wort für #428
    (gv-vergleicher); … Kein Merge-Wort für Welle 9." still grants gv-vergleicher."""
    out = []
    for line in go_lines(herd)[-GO_TAIL:]:
        if not re.search(r"merge-wort", line, re.I):
            continue
        for sent in re.split(r"(?<=[.;])\s+", line):
            if re.search(r"merge-wort", sent, re.I) and not NO_WORD.search(sent):
                out.append(sent)
    return out


def has_merge_word(herd, s):
    pat = re.compile(rf"(?<![\w-]){re.escape(s)}(?![\w-])")
    return any(pat.search(x) for x in merge_word_sentences(herd))


def current_wave(herd):
    """The largest N in the last GO.md line that names a "Welle N"; None without one."""
    for line in reversed(go_lines(herd)):
        ns = [int(n) for n in re.findall(r"\bWelle\s+(\d+)", line)]
        if ns:
            return max(ns)
    return None


def tail_text(path, nbytes=16384):
    try:
        with open(path, "rb") as f:
            f.seek(max(0, os.path.getsize(path) - nbytes))
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def failed_in_chains(herd):
    """Slices listed in any <herd>/merge-*.gescheitert (one slice per line)."""
    out = set()
    for p in glob.glob(os.path.join(herd, "merge-*.gescheitert")):
        out.update(read_list(p))
    return out


def reprobe_conflict(herd, s, since=None):
    """True when the slice's last re-probe (<herd>/reprobe-<slice>.log, appended by reprobe.sh) ended in a merge
    conflict: its last verdict line is "KONFLIKT: <files>", or a chain lists the slice as failed and the log names
    KONFLIKT without a later verdict. A log older than `since` (the review_ok) is history. Reads the log only."""
    p = os.path.join(herd, f"reprobe-{s}.log")
    try:
        if since is not None and os.path.getmtime(p) < since - 60:
            return False
    except OSError:
        return False
    text = tail_text(p)
    verdict = None
    for line in text.splitlines():
        ls = line.strip()
        if ls.startswith("KONFLIKT"):
            verdict = "conflict"
        elif ls.startswith(("sauber", "NEU ROT")) or "Kopf/Zustand jetzt" in ls:  # a later run's other verdict
            verdict = "other"
    if verdict:
        return verdict == "conflict"
    return "KONFLIKT" in text and s in failed_in_chains(herd)


def _systemctl(*args):
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    r = subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=5, env=env)
    return r.stdout if r.returncode == 0 else ""


def active_units():
    """[{"unit": name, "since": epoch|None, "cmd": ExecStart argv as one string}] of active systemd user units
    matching UNIT_PATTERNS, cached UNITS_CHECK_S; [] without systemd."""
    def ask():
        try:
            names = []
            for l in _systemctl("list-units", *UNIT_PATTERNS, "--state=active", "--no-legend", "--plain").splitlines():
                parts = l.split()
                if parts and parts[0].endswith(".service"):
                    names.append(parts[0])
            if not names:
                return []
            since, cmd, cur = {}, {}, None
            for l in _systemctl("show", *names, "-p", "Id,ActiveEnterTimestamp,ExecStart",
                                "--timestamp=unix").splitlines():
                k, _, v = l.partition("=")
                if k == "Id":
                    cur = v
                elif k == "ActiveEnterTimestamp" and cur:
                    m = re.search(r"@(\d+)", v) or re.search(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)", v)
                    since[cur] = (int(m[1]) if m[0].startswith("@") else
                                  time.mktime(time.strptime(m[1], "%Y-%m-%d %H:%M:%S"))) if m else None
                elif k == "ExecStart" and cur:
                    m = re.search(r"argv\[\]=(.*?) ; ignore_errors=", v)
                    cmd[cur] = m[1] if m else ""
            return [{"unit": n[:-len(".service")], "since": since.get(n), "cmd": cmd.get(n, "")} for n in names]
        except Exception:
            return []
    return _cached(("units",), UNITS_CHECK_S, ask) or []


# ---------------------------------------------------------------------------------------------------------------
# Chains & runs: one plain row per service — what happens now, how far, when done, does anyone have to act
# ---------------------------------------------------------------------------------------------------------------

RUN_PROC_S = 10          # the /proc scan for reprobe.sh / herd-merge is cached this long
DUR_SAMPLES = 5          # a test run's expected length = median of the last DUR_SAMPLES runs of the same kind
DUR_MAX_S = 4 * 3600     # longer "runs" are log artefacts (a chain restarted the next day), not samples
GV_LOOP = os.environ.get("HERD_BOARD_GV_LOOP", "/workspace/.m2herd/gv-loop")
STEP_LINE = re.compile(r"^==\s+(\S+)(?:\s+(\d\d):(\d\d)Z?)?\s*$")
END_LINE = re.compile(r"^(fertig|GESCHEITERT)\s+(\S+)(?:\s+(\d\d):(\d\d)Z?)?\s*$")
GATE = re.compile(r"\^([\w.-]+) \+merged")   # `until herd-phase … | grep -qE "^<slice> +merged"`: waits for a merge


def berlin(epoch, fmt="%H:%M"):
    """A clock time in DAY_TZ (Europe/Berlin), whatever the machine's TZ is."""
    try:
        import datetime, zoneinfo
        return datetime.datetime.fromtimestamp(epoch, zoneinfo.ZoneInfo(DAY_TZ)).strftime(fmt)
    except Exception:
        return time.strftime(fmt, time.localtime(epoch))


def clock(epoch):
    """HH:MM today, the date ("24.11.") on another day — one word, so a wrapped row never splits it. Europe/Berlin."""
    if not epoch:
        return ""
    return berlin(epoch, "%H:%M" if berlin(epoch, "%Y%m%d") == berlin(time.time(), "%Y%m%d") else "%d.%m.")


def dur(seconds):
    """A duration in plain words: "12 min", "2 h 05"."""
    m = max(0, int(round(seconds / 60)))
    return t("dur_min", m=m) if m < 60 else t("dur_h", h=m // 60, m=m % 60)


def utc_stamps(hms, ref):
    """Epochs for a log's time-only UTC stamps [(h, m, s), ...] in file order: the last one is the latest such time at
    or before `ref` (the file's mtime), each earlier one the latest at or before its successor (midnight rollover)."""
    out = []
    for h, m, s in reversed(hms):
        day = time.gmtime(ref)
        e = calendar.timegm((day.tm_year, day.tm_mon, day.tm_mday, h, m, s))
        if e > ref + 90:
            e -= 86400
        out.append(e)
        ref = e
    return out[::-1]


def chain_log(path):
    """A chain log (<herd>/<unit>.log, merge-kette-11.log, …) -> {"runs": [(slice, start, end|None, verdict)],
    "cur": slice|None, "ended": slice|None}. "== <slice> HH:MM" opens a run (a repeat while open is the inner
    script's echo), "fertig|GESCHEITERT <slice> HH:MM" closes it. Cached until the file changes."""
    def load(p):
        if not p:
            return {"runs": [], "cur": None, "ended": None}
        lines = tail_text(p, 65536).splitlines()
        marks = []  # (kind, slice, (h, m) or None)
        for line in lines:
            m = STEP_LINE.match(line)
            if m:
                marks.append(("start", m[1], (int(m[2]), int(m[3]), 0) if m[2] else None))
                continue
            m = END_LINE.match(line)
            if m:
                marks.append((m[1], m[2], (int(m[3]), int(m[4]), 0) if m[3] else None))
        stamped = [x[2] for x in marks if x[2]]
        epochs = iter(utc_stamps(stamped, os.path.getmtime(p)))
        runs, open_, cur, ended = [], {}, None, None
        for kind, s, hm in marks:
            e = next(epochs) if hm else None
            if kind == "start":
                if s not in open_:
                    open_[s] = e
                cur = s
            elif s in open_:
                runs.append((s, open_.pop(s), e, kind))
                if s == cur:
                    ended, cur = s, None
        if cur:
            runs.append((cur, open_.get(cur), None, None))
        return {"runs": runs, "cur": cur, "ended": ended}
    return _by_mtime("chainlog", path, load)


def slice_kind(herd, s):
    """"ui" when the slice touches gst-gen-ui only (lint + tsc, a minute or two), else "suite" (the pytest suite)."""
    repos = {l.split()[0] for l in read_list(os.path.join(herd, f"{s}.repos")) if l.split()}
    return "ui" if repos and repos <= {"gst-gen-ui"} else "suite"


def expected_run_s(herd, s):
    """Median length of the last DUR_SAMPLES finished re-probe + merge runs of the slice's kind (ui / suite), from the
    "== <slice> HH:MM" … "fertig <slice> HH:MM" stamps of the herd's chain logs; None with fewer than two samples."""
    kind = slice_kind(herd, s)
    seen, samples = set(), []
    for p in glob.glob(os.path.join(herd, "merge-*.log")):
        try:
            if time.time() - os.path.getmtime(p) > 3 * 86400:
                continue
        except OSError:
            continue
        for sl, a, b, verdict in chain_log(p)["runs"]:
            if verdict != "fertig" or not a or not b or not 0 < b - a <= DUR_MAX_S or sl == s:
                continue
            key = (sl, int(b // 120))
            if key not in seen:
                seen.add(key)
                samples.append((b, b - a, sl))
    same = [d for b, d, sl in sorted(samples, reverse=True) if slice_kind(herd, sl) == kind][:DUR_SAMPLES]
    if len(same) < 2:
        return None
    same.sort()
    return same[len(same) // 2]


def run_procs():
    """[(argv list, start epoch)] of every process, cached RUN_PROC_S (one /proc scan per repaint at most)."""
    def scan():
        out = []
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                argv = open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
                out.append(([a for a in argv if a], os.stat(f"/proc/{pid}").st_mtime))
            except OSError:
                continue
        return out
    return _cached(("procs",), RUN_PROC_S, scan) or []


def chain_step(s):
    """What the chain does with slice `s` right now: ("test", since) while reprobe.sh runs for it, ("slot", since)
    while suite-slot.sh still waits for a test slot for that reprobe, ("merge", since) while herd-merge runs, else None."""
    found = {}
    for argv, start in run_procs():
        if s not in argv[1:]:
            continue
        base = [os.path.basename(a) for a in argv[:2]]
        if "herd-merge" in base:
            kind = "merge"
        elif base[0] == "reprobe.sh" or base[1:2] == ["reprobe.sh"]:
            kind = "test"
        elif any(a.endswith("reprobe.sh") for a in argv) and any(b.startswith("suite-slot") for b in base):
            kind = "slot"
        else:
            continue
        found[kind] = min(start, found.get(kind, start))
    for kind in ("merge", "test", "slot"):
        if kind in found:
            return kind, found[kind]
    return None


def fail_reason(herd, s):
    """Why a chain gave up on a slice, from its last re-probe log: "KONFLIKT: <file>", "rot: <test>", "stale", ..."""
    reason = ""
    for line in tail_text(os.path.join(herd, f"reprobe-{s}.log")).splitlines():
        ls = line.strip()
        if ls.startswith("KONFLIKT"):
            files = ls.partition(":")[2].split()
            reason = "KONFLIKT" + (": " + os.path.basename(files[0]) + (f" +{len(files) - 1}" if len(files) > 1 else "")
                                   if files else "")
        elif ls.startswith("NEU ROT"):
            tests = ls.partition(":")[2].split()
            reason = t("f_red", x=tests[0].split("::")[-1] if tests else "?")
        elif "Kopf/Zustand jetzt" in ls:
            reason = "stale"
        elif ls.startswith("TESTS LIEFEN NICHT") or (ls.startswith("Setup") and "fehlgeschlagen" in ls):
            reason = t("f_setup")
        elif ls.startswith("sauber"):
            reason = t("f_merge")
    return reason


def script_of(u, herds):
    """(script path, its extra arguments) of a unit: the .sh in its ExecStart, else <herd>/<unit>.sh."""
    try:
        argv = shlex.split(u.get("cmd") or "")
    except ValueError:
        argv = (u.get("cmd") or "").split()
    for i, a in enumerate(argv):
        if a.endswith(".sh") and os.path.isfile(a):
            return a, argv[i + 1:]
    for h in herds:
        p = os.path.join(h, f"{u['unit']}.sh")
        if os.path.isfile(p):
            return p, []
    return None, []


def read_text(path):
    return _by_mtime("text", path, lambda p: open(p, encoding="utf-8", errors="replace").read() if p else "")


def unit_label(name, script_text=""):
    m = re.match(r"^merge-welle(.+)$", name)
    if m:
        return t("u_wave", n=m[1])
    if name == "merge-vorfahrt":
        return t("u_vorfahrt")
    if name.startswith("merge-"):
        return t("u_merge", n=name[len("merge-"):])
    m = re.match(r"^gv-runde-0*(\d+)$", name)
    if m:
        return t("u_gv", n=m[1])
    if name.startswith("recalc-"):
        return t("u_recalc_st") if "staging" in script_text.lower() else t("u_recalc")
    return name


WAIT_WHY = {"fix_queued": "r_fix", "review_running": "r_review", "review_befund": "r_findings", "queued": "r_queue",
            "accepted": "r_accepted", "parked": "r_parked"}


def chain_row(u, herds, states):
    """A merge chain: slice list from W8="…" in its script (or the slices it was started with), phases from the herd
    state, the slice it is at from its log, the step from the processes, failures from <script>.gescheitert."""
    name = u["unit"]
    script, args = script_of(u, herds)
    herd = os.path.dirname(script) if script else None
    if herd not in herds:
        herd = next((h for h in herds if os.path.exists(os.path.join(h, f"{name}.log"))), herd or (herds[0] if herds else ""))
    text = read_text(script) if script else ""
    m = re.search(r"""^\s*W\d*=["']([^"']+)["']""", text, re.M)
    slices = m[1].split() if m else [a for a in args if not a.startswith("-")]
    base = os.path.splitext(os.path.basename(script))[0] if script else name
    log = next((p for p in (os.path.join(herd, f"{name}.log"), os.path.join(herd, f"{base}.log")) if os.path.exists(p)),
               None)
    info = chain_log(log) if log else {"cur": None, "ended": None, "runs": []}
    failed = [x for x in read_list(os.path.join(herd, f"{base}.gescheitert"))
              if x and (not slices or x in slices)]
    st = states.get(herd) or {}
    ph = lambda s: (st.get(s) or {}).get("phase")
    cur = info["cur"]
    parts, more = [], []
    if slices:
        parts.append(t("n_merged", n=sum(1 for s in slices if ph(s) == "merged"), m=len(slices)))
    if cur:
        step = chain_step(cur)
        start = next((a for s, a, b, v in reversed(info["runs"]) if s == cur and b is None), None) or \
            (step[1] if step else None)
        if step and step[0] == "merge":
            what = t("step_merge")
        elif step and step[0] == "slot":
            what = t("step_slot", d=dur(time.time() - step[1]))
        elif step:
            exp = _cached(("runlen", herd, cur), UNITS_CHECK_S, lambda: expected_run_s(herd, cur))
            mins = int((time.time() - (start or step[1])) // 60)
            what = t("step_test", n=mins, m=round(exp / 60)) if exp else t("step_test_n", n=mins)
        else:
            what = t("step_run", d=dur(time.time() - start)) if start else t("step_between")
        parts.append(t("now_at", s=cur, what=what))
    rest = [s for s in slices if ph(s) != "merged" and s not in failed and s != cur]
    ready = [s for s in rest if ph(s) == "review_ok"]
    if cur and ready:
        i = slices.index(cur) if cur in slices else -1
        order = slices[i + 1:] + slices[:i + 1]
        parts.append(t("next", s=next(s for s in order if s in ready)))
    elif ready:
        parts.append(t("starts", s=ready[0]))
    elif slices and not cur and not rest:
        parts.append(t("all_done"))
    elif not slices:  # a chain whose script names no slice list: the old view (slice it is at / last one)
        parts.append(t("chain_at", s=cur) if cur else t("chain_last", s=info["ended"]) if info["ended"] else "")
    waits = []
    for s in rest:
        p = ph(s)
        if p == "review_ok":
            continue
        ev = st.get(s) or {}
        key = "r_fix" if p == "working" and "fix_queued" in (ev.get("history") or []) else \
            "r_work" if p == "working" else WAIT_WHY.get(p, "r_unknown")
        waits.append(f"{s} ({t(key)})")
    if waits:
        more.append((t("wait_for", x=", ".join(waits)), YEL))
    if failed:
        more.append((t("failed_list", x=", ".join(f"{s} ({r})" if (r := fail_reason(herd, s)) else s for s in failed)),
                     RED))
    col = ORANGE if failed else CYAN
    return (0, unit_label(name), "»", col, "", " · ".join(p for p in parts if p), "",
            {"thin": True, "busy": bool(cur or ready), "more": more, "sort": name, "cur": cur})


def gv_log(path):
    """runde.log of a comparison round -> {"start", "cases", "started": {case: epoch}, "ended": {case: epoch},
    "done": bool}. Reads only the round log (gv-loop GEMEINSAM.md: no case folder is opened)."""
    def load(p):
        out = {"start": None, "cases": [], "started": {}, "ended": {}, "done": False}
        if not p:
            return out
        rows = []
        for line in tail_text(p, 65536).splitlines():
            m = re.match(r"^\[(\d\d):(\d\d):(\d\d)Z\]\s+(.*)$", line)
            if m:
                rows.append(((int(m[1]), int(m[2]), int(m[3])), m[4]))
        for e, (_, msg) in zip(utc_stamps([r[0] for r in rows], os.path.getmtime(p)), rows):
            out["start"] = out["start"] or e
            m = re.match(r"^Runde \S+, Fälle: (.+?), parallel", msg)
            if m:
                out["cases"] = m[1].split()
            m = re.match(r"^Fall (\S+?)(?: \([^)]*\))?: (Treiber startet|Vergleich beendet)", msg)
            if m:
                out["started" if m[2] == "Treiber startet" else "ended"][m[1]] = e
            if re.match(r"^Runde \S+ fertig", msg):
                out["done"] = True
        return out
    return _by_mtime("gvlog", path, load)


def gv_cases_default(loop, nn):
    """The round's cases when the log has no header yet: LERNFAELLE in runde.sh, plus PRUEFFAELLE every third round."""
    text = read_text(os.path.join(loop, "runde.sh"))
    get = lambda k: (re.search(rf'^{k}="([^"]*)"', text, re.M) or [None, ""])[1].split()
    return get("LERNFAELLE") + (get("PRUEFFAELLE") if int(nn) % 3 == 0 else [])


def gv_row(u, herds, states):
    name = u["unit"]
    nn = re.match(r"^gv-runde-(\d+)$", name)[1]
    cmd = u.get("cmd") or ""
    m = re.search(r"(\S+)/runde\.sh\b", cmd)
    loop = m[1] if m else GV_LOOP
    m = re.search(r"--runde\s+(\d+)", cmd)
    nn = m[1] if m else nn
    log = os.path.join(loop, "runden", nn, "runde.log")
    since = u.get("since") or 0
    try:
        fresh = os.path.getmtime(log) >= since - 60
    except OSError:
        fresh = False
    parts, more = [], []
    if not fresh:
        gate = GATE.search(cmd)
        merged = gate and any((st.get(gate[1]) or {}).get("phase") == "merged" for st in states.values())
        parts.append(t("gate", s=gate[1]) if gate and not merged else t("gv_starting"))
    else:
        g = gv_log(log)
        cases = g["cases"] or gv_cases_default(loop, nn)
        n = len(cases) or len(g["started"])
        done = [c for c in g["started"] if c in g["ended"]]
        running = sorted((g["started"][c], c) for c in g["started"] if c not in g["ended"])
        if g["done"]:
            parts.append(t("gv_done"))
        elif running:
            parts.append(t("gv_case", i=len(done) + 1, n=n, f=running[-1][1]))
        elif n and len(done) >= n:
            parts.append(t("gv_report"))
        if g["start"]:
            parts.append(t("gv_since", d=dur(time.time() - g["start"])))
        lens = [g["ended"][c] - g["started"][c] for c in done]
        if not lens:  # nothing finished yet: the previous round's cases
            prev = os.path.join(loop, "runden", f"{int(nn) - 1:0{len(nn)}d}", "runde.log")
            if os.path.exists(prev):
                p = gv_log(prev)
                lens = [p["ended"][c] - p["started"][c] for c in p["started"] if c in p["ended"]]
        if running and lens and not g["done"]:
            mean = sum(lens) / len(lens)
            left = max(0, n - len(done) - len(running))
            eta = max(running[-1][0] + mean, time.time() + 60) + mean * left
            parts.append(t("gv_eta", t=clock(eta)))
    return (1, unit_label(name), "▸", BLUE, "", " · ".join(parts), "",
            {"thin": True, "busy": True, "more": more, "sort": name})


def short_project(p):
    """A project slug short enough for one row: leading short tokens (gs, ga, ber, drv) dropped, two words kept."""
    if len(p) <= 22:
        return p
    k = p.split("_")
    i = next((i for i, x in enumerate(k) if len(x) > 3), 0)
    return "_".join(k[i:i + 2])


def recalc_row(u, herds, states):
    """A recalculation run: projects from `for p in …; do` in its script, progress from its log ("== <project> HH:MMZ"
    when one starts, "done |" when its job finished, "warte auf Staging" while the deploy is awaited)."""
    name = u["unit"]
    script, _ = script_of(u, herds)
    text = read_text(script) if script else ""
    herd = os.path.dirname(script) if script else (herds[0] if herds else "")
    m = re.search(r"\bfor\s+\w+\s+in\s+([^;\n$`]+?)\s*;\s*do", text)
    projects = m[1].split() if m else []
    log = os.path.join(herd, f"{name}.log")
    lines = tail_text(log, 65536).splitlines()
    marks = [(i, (int(m[1]), int(m[2]), 0)) for i, l in enumerate(lines)
             if (m := re.match(r"^(?:==\s+\S+|main \S+)\s+(\d\d):(\d\d)Z", l))]
    at = dict(zip((i for i, _ in marks), utc_stamps([x for _, x in marks], os.path.getmtime(log)))) if marks else {}
    state, start, now_p, staging, failed = {}, {}, None, None, ""
    for i, line in enumerate(lines):
        m = re.match(r"^==\s+(\S+)", line)
        if m:
            now_p, state[m[1]], start[m[1]] = m[1], "run", at.get(i)
            projects += [] if m[1] in projects else [m[1]]
        elif re.match(r"^done\s*\|", line) and now_p:
            state[now_p] = "done"
        elif "warte auf Staging" in line:
            staging = at.get(i) or time.time()
        elif line.startswith("Staging auf"):
            staging = None
        elif "nichts neu berechnet" in line:
            failed = line.strip()
    parts, more = [], []
    if not state:
        gate = GATE.search(text)
        merged = gate and any((st.get(gate[1]) or {}).get("phase") == "merged" for st in states.values())
        if staging:
            parts.append(t("rc_staging", d=dur(time.time() - staging)))
        elif gate and not merged and not failed:
            parts.append(t("gate", s=gate[1]))
    if state or not parts:
        for p in projects:
            s = state.get(p)
            parts.append(t("rc_done", p=short_project(p)) if s == "done" else
                         t("rc_run", p=short_project(p), d=dur(time.time() - start[p])) if s == "run" and start.get(p)
                         else t("rc_run_n", p=short_project(p)) if s == "run" else t("rc_wait", p=short_project(p)))
    if failed:
        more.append((failed, RED))
    return (1, unit_label(name, text), "▸", ORANGE if failed else BLUE, "", " · ".join(parts), "",
            {"thin": True, "busy": True, "more": more, "sort": name})


def vorfahrt_row(u, herds, cur):
    """merge-vorfahrt only while it holds worker test runs (pids in <herd>/merge-vorfahrt.angehalten), else None."""
    script, _ = script_of(u, herds)
    herd = os.path.dirname(script) if script else (herds[0] if herds else "")
    pids = [p for p in read_list(os.path.join(herd, "merge-vorfahrt.angehalten")) if p.strip().isdigit()]
    held = sum(1 for p in pids if os.path.exists(f"/proc/{p.strip()}"))
    if not held:
        return None
    text = t("vf_holds", n=held, s=cur) if cur else t("vf_holds0", n=held)
    return (0, unit_label(u["unit"]), "»", CYAN, "", text, "", {"thin": True, "busy": True, "sort": u["unit"] + "~"})


def unit_rows(herds, states=None):
    """One row per active service under "Chains & runs": merge chains (what is merged, the slice now and its step,
    the next one, who it waits for, what failed), comparison rounds (case i/n, since, ETA), recalculations (project
    by project), merge-vorfahrt only while it holds test runs. `states` = {herd: herd_events.state(herd)}."""
    states = states or {}
    rows, vorfahrt = [], []
    for u in active_units():
        name = u["unit"]
        try:
            if name == "merge-vorfahrt":
                vorfahrt.append(u)
            elif name.startswith("merge-"):
                rows.append(chain_row(u, herds, states))
            elif name.startswith("gv-runde-"):
                rows.append(gv_row(u, herds, states))
            elif name.startswith("recalc-"):
                rows.append(recalc_row(u, herds, states))
            else:
                rows.append((1, name, "▸", BLUE, "", t("unit_since", t=clock(u.get("since"))) if u.get("since") else "",
                             "", {"thin": True, "busy": True}))
        except Exception as e:  # one odd log must not hide the other services
            rows.append((1, name, "▸", ORANGE, "", f"{type(e).__name__}: {e}", "", {"thin": True, "busy": True}))
    cur = next((r[7].get("cur") for r in rows if r[7].get("cur")), None)
    rows += [r for r in (vorfahrt_row(u, herds, cur) for u in vorfahrt) if r]
    return rows


def run_lines(row, w):
    """A Chains & runs row: heading + state (up to two continuation lines); "wartet"/"gescheitert" in their colour
    on the same line when everything fits, otherwise each on a line of its own."""
    _, name, icon, col, _, text, _, d = row
    more = d.get("more") or []
    text = f"· {text}" if text else ""  # "Merge Welle 15 · 6/8 gemergt · …": the label is a name, not a sentence
    row = row[:5] + (text,) + row[6:]
    if more:
        full = " · ".join([text] + [m for m, _ in more]) if text else "· " + " · ".join(m for m, _ in more)
        if len(icon) + 1 + len(name) + 1 + len(full) <= w:
            segs = ([paint(text)] if text else [f"{DIM}·{RST}"]) + [paint(m, c) for m, c in more]
            return [f"{col}{icon}{RST} {col}{name}{RST} " + f"{DIM} · {RST}".join(segs)]
    out = head_lines(row, w, 2)
    out = out[:1] + [re.sub(r"^  · ", "  ", l) for l in out[1:]]  # a continuation line does not start with a dot
    for m, c in more:
        out += [f"  {paint(l, c)}" for l in wrap(m, w - 2, 2)]
    return out


def min_free_gb(herd):
    """HERD_MIN_FREE_MB (environment, then <herd>/limits.env, else 8000 like herd-limits) in GB."""
    v = os.environ.get("HERD_MIN_FREE_MB") or _limits_env(herd).get("HERD_MIN_FREE_MB") or "8000"
    try:
        return round(int(v) / 1000)
    except ValueError:
        return 8


# ---------------------------------------------------------------------------------------------------------------
# v2 herds: lanes from herd_events.state() plus computed states
# ---------------------------------------------------------------------------------------------------------------

READYISH = ("accepted", "review_running", "review_ok", "review_befund")
AT_LEAST_ACCEPTED = READYISH + ("merged",)
PR_REF = re.compile(r"^\s*([\w./-]+?)\s*#\s*(\d+)(?:\s*@\s*([0-9a-f]{7,40}))?\s*$")
MAIN_REF = re.compile(r"^\s*([\w./-]+?)\s*@\s*([0-9a-f]{7,40})\s*$")


def model_tag(model, effort):
    """`O·hi` from model claude-opus-5-5 and effort high; empty when the event names neither."""
    m = str(model or "").lower()
    letter = next((v for k, v in (("opus", "O"), ("fable", "F"), ("sonnet", "S"), ("haiku", "H"), ("gpt", "G"),
                                  ("codex", "X")) if k in m), (re.sub(r"[^a-z]", "", m)[:1] or "").upper())
    e = str(effort or "").lower()
    eff = {"low": "lo", "medium": "md", "high": "hi", "xhigh": "xh", "max": "mx"}.get(e, e[:2])
    return "·".join(x for x in (letter, eff) if x)


def ts_epoch(ts):
    try:
        return calendar.timegm(time.strptime(str(ts)[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None


def cwd_for(wts, repo=""):
    """The slice worktree that belongs to `repo` (its path names the repo), else the first existing one."""
    paths = [os.path.expanduser(str(w)) for w in wts]
    name = str(repo or "").split("/")[-1]
    full = REPOS.get(name, name).split("/")[-1] if name else ""
    for p in paths:
        if full and f"/{full}/" in p + "/" and os.path.isdir(p):
            return p
    return next((p for p in paths if os.path.isdir(p)), None)


def stale_of(ev, wts, merged_evs, package_members):
    """Why a review_ok is stale (computed, docs §1), or "": a PR head moved off the reviewed sha, the repo's main moved
    off the recorded sha, or a `merged` event of another package on a covered repo landed after the review."""
    covered = set()
    for ref in as_list(ev.get("prs")):
        m = PR_REF.match(str(ref))
        if not m:
            continue
        covered.add(short_repo(m[1]))
        if not m[3]:
            continue
        state, head = pr_state(slug_for(m[1]), int(m[2]), cwd_for(wts, m[1]))
        if head and state in (None, "OPEN") and not (head.startswith(m[3]) or m[3].startswith(head)):
            return t("stale_head", ref=f"{short_repo(m[1])}#{m[2]}")
    recorded = set()
    for ref in as_list(ev.get("main")):
        m = MAIN_REF.match(str(ref))
        if not m:
            continue
        recorded.add(short_repo(m[1]))
        cur = main_head(slug_for(m[1]), cwd_for(wts, m[1]))
        if cur and not (cur.startswith(m[2]) or m[2].startswith(cur)):
            return t("stale_main", repo=short_repo(m[1]))
    # a review_ok without a main sha for a covered repo (herd-recover's migrated v1 sign-off) cannot be merged:
    # herd-merge refuses it, so it needs a re-probe, never the merge word
    for repo in sorted(covered - recorded):
        return t("stale_nomain", repo=repo)
    covered |= recorded
    for mev in merged_evs:
        if mev.get("slice") in package_members or str(mev.get("ts", "")) <= str(ev.get("ts", "")):
            continue
        for ref in as_list(mev.get("prs")):
            m = PR_REF.match(str(ref))
            if m and short_repo(m[1]) in covered:
                return t("stale_main", repo=short_repo(m[1]))
    return ""


def is_stale_main(why):
    """True when a stale reason from stale_of() is "main moved" (not a moved PR head or a missing main sha)."""
    pat = re.escape(STRINGS[LANG]["stale_main"]).replace(re.escape("{repo}"), ".+")
    return bool(re.fullmatch(pat, why or ""))


def has_pr(herd, s, ev):
    """A slice has something to merge: a <slice>.repos AND a PR, in the event's prs field or as "#n"/a pull URL in
    its status.json "pr". review_ok events of measurements, drafts and analyses (eval/* branches) carry none."""
    if not os.path.exists(os.path.join(herd, f"{s}.repos")):
        return False
    if any(PR_REF.match(str(r)) for r in as_list(ev.get("prs"))):
        return True
    pr = read_status(os.path.join(herd, f"{s}.status.json")).get("pr") or ""
    return bool(re.search(r"#\s*\d+|/pull/\d+", pr))


def safe_repos(herd, s):
    try:
        return he.repos(herd, s)
    except (OSError, ValueError):
        return []


def pr_refs(ev):
    """`api#210@6cb1f80` short refs of an event's prs field."""
    out = []
    for ref in as_list(ev.get("prs")):
        m = PR_REF.match(str(ref))
        if m:
            # simple view: just the PR number („api #224“); the reviewed sha only with HERD_BOARD_DETAIL
            out.append(f"{short_repo(m[1])}#{m[2]}" + (f"@{m[3][:7]}" if m[3] else "") if DETAIL
                       else f"{short_repo(m[1])} #{m[2]}")
    return out


def limits_reason(limits):
    if not limits or limits.get("ok"):
        return ""
    return {"memory": t("w_mem"), "load": t("w_load")}.get(limits.get("reason"), t("w_slot"))


def v2_rows(herd, agents, limits, merged_evs, lanes):
    """Rows of one v2 herd into lanes {"queue", "work", "ready"}. Row = (rank, name, icon, colour, n/m, text,
    tail, detail). Returns the herd's state, so the caller does not read the file again."""
    st = he.state(herd)
    lastwork, hdrs = {}, {}
    for ev in he.read(herd):
        if ev["phase"] == "working":
            lastwork[ev["slice"]] = ev

    def hdr(s):
        if s not in hdrs:
            try:
                hdrs[s] = he.task_header(herd, s)
            except (OSError, ValueError):
                hdrs[s] = {}
        return hdrs[s]

    def tag(s):
        if not DETAIL:
            return ""
        w = lastwork.get(s) or {}
        return model_tag(w.get("model") or hdr(s).get("model"), w.get("effort") or hdr(s).get("effort"))

    def tail(*parts):
        return " ".join(p for p in parts if p)

    def phase(s):
        return (st.get(s) or {}).get("phase")

    clash = herd_clash(herd) if DETAIL else {}
    live = {s for s, ev in st.items() if ev["phase"] not in ("merged", "parked")}
    clash_of = lambda *ss: ", ".join(sorted({o for s in ss for o in clash.get(s, ()) if o in live and o not in ss}))

    # 2. queue: fix_queued first (by time), then queued by `pos`, queue.txt order, time
    qtxt = read_list(os.path.join(herd, "queue.txt"))
    qidx = lambda s: qtxt.index(s) if s in qtxt else 10 ** 6
    pos_of = lambda ev: ev.get("pos") if isinstance(ev.get("pos"), int) and not isinstance(ev.get("pos"), bool) \
        else 10 ** 6
    fixq = sorted((s for s, ev in st.items() if ev["phase"] == "fix_queued"), key=lambda s: str(st[s].get("ts", "")))
    qd = sorted((s for s, ev in st.items() if ev["phase"] == "queued"),
                key=lambda s: (pos_of(st[s]), qidx(s), str(st[s].get("ts", "")), s))
    for i, s in enumerate(fixq + qd):
        base = hdr(s).get("stacked_on") or ""
        why = t("w_base_q", b=base) if base and phase(base) not in AT_LEAST_ACCEPTED else limits_reason(limits)
        d = {"clash": clash_of(s)}
        if s in fixq:
            text = t("fix_queued", pos=i + 1)
            row = (i, s, "!", ORANGE, "", text + (f" · {why}" if why else ""), tag(s), d)
        else:
            row = (i, s, "◌", DIM, "", t("queued", pos=i + 1) + (f" · {why}" if why else ""), tag(s), d)
        lanes["queue"].append(row)

    # 3. working (+ computed reported / still / gone; blocked comes first, in yellow)
    for s, ev in st.items():
        if ev["phase"] != "working":
            continue
        pane = ev.get("pane") if isinstance(ev.get("pane"), str) else ""
        a = agents.get(pane) if pane else None
        wts = as_list(ev.get("wt"))
        report = os.path.exists(os.path.join(herd, f"{s}.out.md"))
        stj = read_status(os.path.join(herd, f"{s}.status.json"))
        acts = procs_in(s, [str(w) for w in wts])
        t_age = transcript_age(a["cwd"]) if a and a.get("cwd") else None
        age = f"{int(t_age)}m" if t_age is not None and t_age >= 1 else ""
        n, m = field(stj, "step", "schritt"), field(stj, "of", "von")
        prog = f"{n}/{m}" if isinstance(n, int) and isinstance(m, int) else ""
        since = ts_epoch(ev.get("since"))
        fresh = since is not None and time.time() - since < START_GRACE_S
        status = (a or {}).get("agent_status")
        d = {"satz": field(stj, "sentence", "satz") or "", "fehlt": field(stj, "missing", "fehlt") or "", "n": n,
             "m": m, "acts": acts, "jsonl": newest_jsonl(a["cwd"]) if a and a.get("cwd") else None,
             "clash": clash_of(s)}
        if status == "blocked":
            lanes["work"].append((0, s, "?", YEL, "", t("needs_answer"), tail(age, tag(s)), {"clash": d["clash"]}))
            continue
        if report and (not a or status in ("idle", "done")) and not acts:
            pr = stj.get("pr") or ""
            row = (1, s, "✓", GREEN, "", (f"{pr} · " if pr else "") + t("checking"), tail(age, tag(s)),
                   dict(d, thin=True, satz="", fehlt="", n=None, m=None))
        elif not a:
            row = (2, s, "●", CYAN, prog, t("starting"), tag(s), d) if fresh else \
                (0, s, "✕", RED, "", t("ended"), tag(s), d)
        elif not acts and status != "working" and t_age is not None and t_age >= STILL_MIN:
            row = (0, s, "⚠", RED, "", f"{t('still')} {age}", tag(s), d)
        else:
            busy = acts[0][0] if acts else ""
            fix_round = "fix_queued" in ev.get("history", [])
            icon, col = ("⧗", CYAN) if busy in LONG_RUNS else ("↺", ORANGE) if fix_round else ("●", CYAN)
            row = (2, s, icon, col, prog, kurz(stj) or busy or t("working"), tail(age, tag(s)), d)
        lanes["work"].append(row)

    # 4. packages: one row per package with any member past `accepted`; reviewed on current heads -> merge word
    done = set()
    for s in sorted(st):
        if phase(s) not in READYISH:
            continue
        try:
            members = he.package(herd, s)
        except (OSError, ValueError):
            members = [s]
        if s not in members:
            members = sorted(set(members) | {s})
        if tuple(members) in done:
            continue
        done.add(tuple(members))
        name = "+".join(members)
        ph = {m: phase(m) for m in members}
        waiting = [m for m in members if ph[m] not in AT_LEAST_ACCEPTED]
        wts = [w for m in members for w in as_list((lastwork.get(m) or {}).get("wt"))]
        stale = {m: stale_of(st[m], wts, merged_evs, members) for m in members if ph[m] == "review_ok"}
        refs = [r for m in members if ph[m] in ("review_ok", "review_befund", "accepted", "review_running")
                for r in pr_refs(st[m])]
        tags = tail(*dict.fromkeys(tag(m) for m in members if tag(m)))
        c = clash_of(*members)
        d = {"clash": c if c.count(",") < 1 else str(c.count(",") + 1)}  # two or more: just the count, rows stay short
        reviewed = [m for m in members if ph[m] == "review_ok"]
        # a result without a PR (measurement, draft, analysis on an eval/* branch) has nothing to merge: own lane
        if reviewed and all(ph[m] in ("review_ok", "merged") for m in members) and \
                not any(has_pr(herd, m, st[m]) for m in members):
            branches = sorted({r["branch"] for m in members for r in safe_repos(herd, m)})
            lanes["nopr"].append((5, name, "○", DIM, "", t("nopr") + (" · " + ", ".join(branches) if branches else ""),
                                  tags, dict(d, thin=True)))
            continue
        # herd-merge refuses while a stacked_on base outside the package is not merged: no merge word before that
        ext_bases = sorted({hdr(m).get("stacked_on") for m in members if hdr(m).get("stacked_on")
                            and hdr(m)["stacked_on"] not in members and phase(hdr(m)["stacked_on"]) != "merged"})
        # the user's merge word, read from <herd>/GO.md (only when the herd keeps one)
        go = ""
        if has_go_file(herd):
            go = t("go_ok") if all(has_merge_word(herd, m) for m in members if ph[m] != "merged") else t("go_wait")
        conflict = [m for m in reviewed if reprobe_conflict(herd, m, ts_epoch(st[m].get("ts")))]
        if not waiting and not ext_bases and reviewed and all(ph[m] in ("review_ok", "merged") for m in members) \
                and not any(stale.values()) and not conflict:
            word = f"merge {members[0]}"
            text = f"{t('reviewed')} ✓" + (f" · {go}" if go else "") + \
                (f" · {t('word', w=word)}" if DETAIL and go != t("go_ok") else "") + \
                (" · " + " ".join(refs) if refs else "")
            icon, col = ("⏸", YEL) if go == t("go_wait") else ("✓", BLUE)  # blue, like the numbers under Merged today
            lanes["ready"].append((0, name, icon, col, "", text, tags, d))
            continue
        if any(ph[m] == "review_befund" for m in members):
            files = [os.path.basename(str(st[m].get("befunde_file") or "")) for m in members
                     if ph[m] == "review_befund" and st[m].get("befunde_file")]
            row = (0, name, "!", ORANGE, "", t("befund") + (": " + ", ".join(files) if files else ""), tags, d)
        elif conflict:  # the re-probe could not merge onto main: only a worker can resolve it
            row = (0, name, "✕", RED, "", t("conflict") + (" · " + " ".join(refs) if refs else ""), tags,
                   dict(d, bold=True))
        elif any(stale.values()):
            why = next(v for v in stale.values() if v)
            if is_stale_main(why):
                # main moved under a conflict-free package: routine, the chain re-probes before it merges
                chain = any(u["unit"].startswith("merge-") and u["unit"] != "merge-vorfahrt" for u in active_units())
                text = t("main_routine" if chain else "main_due") + (f" · {go}" if go else "") + \
                    (" · " + " ".join(refs) if refs else "")
                row = (2, name, "⟳", DIM, "", text, tags, dict(d, thin=True))
            else:
                row = (1, name, "⟳", YEL, "", f"{t('stale')}: {why}", tags, d)
        elif any(ph[m] == "review_running" for m in members):
            # the loop restarts its own counter at 1 on every call: count the rounds from the slice's history
            # instead (findings so far + 1); a review straight after review_ok is the re-probe after a merge
            hist = next((st[m].get("history") or [] for m in members if ph[m] == "review_running"), [])
            before = [h for h in hist[:-1] if h != "accepted"]
            label = t("reprobe") if before and before[-1] == "review_ok" else \
                t("review_round", n=hist.count("review_befund") + 1)
            row = (2, name, "…", MAG, "", label + (" · " + " ".join(refs) if refs else ""), tags, d)
        elif any(ph[m] == "accepted" for m in members):
            bases = [hdr(m).get("stacked_on") for m in members if ph[m] == "accepted" and hdr(m).get("stacked_on")]
            bases = [b for b in bases if b not in members and phase(b) not in ("review_ok", "merged")]
            why = t("w_partner", x=", ".join(waiting)) if waiting else t("w_base", b=", ".join(bases)) if bases \
                else limits_reason(limits) or t("review_due")
            text = f"{t('accepted')} · {why}" + (" · " + " ".join(refs) if refs else "")
            row = (3, name, "◇", DIM, "", text, tags, d)
        else:  # reviewed, but a partner is not there yet or the base outside the package is not merged
            why = t("w_partner", x=", ".join(waiting)) if waiting else t("w_base", b=", ".join(ext_bases))
            row = (4, name, "✓", BLUE, "", f"{t('reviewed')} " + " ".join(refs) + " · " + why, tags, d)
        lanes["ready"].append(row)
    return st


def merged_from_events(evs):
    """{short repo: [n, ...]} of `merged` events since midnight DAY_TZ."""
    mid, out = day_start()[0], {}
    for ev in evs:
        e = ts_epoch(ev.get("ts"))
        if ev.get("phase") != "merged" or e is None or e < mid:
            continue
        for ref in as_list(ev.get("prs")):
            m = PR_REF.match(str(ref))
            if m:
                out.setdefault(short_repo(m[1]), []).append(int(m[2]))
    return out


# ---------------------------------------------------------------------------------------------------------------
# v1 herds (herd.map, no events): the pre-v2 board, kept only until herd-recover migrates the dir
# ---------------------------------------------------------------------------------------------------------------

def v1_signoffs(herd, s):
    """v1 only: the orchestrator's sign-offs `<slice>.signoff`/`.freigabe`, lines "<repo> #<n> <sha>"."""
    out = {}
    for ext in ("signoff", "freigabe"):
        for l in read_list(os.path.join(herd, f"{s}.{ext}")):
            m = re.match(r"(\S+)\s+#(\d+)\s+([0-9a-f]{7,40})", l)
            if m:
                out[(m[1].lower(), int(m[2]))] = m[3]
    return out


def v1_ready_prs(herd, agents):
    """v1 only: open PRs of workers that are done (report written, not working any more):
    (short repo, n, slice, review)."""
    out = []
    for s, pane in (l.split("=", 1) for l in read_list(os.path.join(herd, "herd.map")) if "=" in l):
        a = agents.get(pane)
        if not os.path.exists(os.path.join(herd, f"{s}.out.md")) or (a and a.get("agent_status") == "working"):
            continue
        pr = read_status(os.path.join(herd, f"{s}.status.json")).get("pr") or ""
        wts = glob.glob(os.path.expanduser(f"~/.herdr/worktrees/*/{s}"))
        wt = a.get("cwd") if a else (wts[0] if wts else None)
        home = os.path.basename(os.path.dirname(wt)) if wt else ""
        refs = []  # (repo for gh — "" = the worker's own repo, name shown on the board, n)
        for m in re.finditer(r"(?:\b([a-z][\w-]*)\s+)?(?:PR\s*)?#(\d+)", pr, re.I):
            short = (m[1] or "").lower()
            repo = REPOS.get(short) or (short if short in SHORT else "")
            refs.append((repo, SHORT.get(repo.split("/")[-1], repo) or SHORT.get(home, home), int(m[2])))
        for m in re.finditer(r"github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)", pr):
            name = m[1].split("/")[1]
            refs.append((m[1], SHORT.get(name, name), int(m[2])))
        ok = v1_signoffs(herd, s)
        for repo, shown, n in dict.fromkeys(refs):
            state, head = pr_state(repo, n, wt)
            if state not in (None, "OPEN"):
                continue
            signed = ok.get((shown.lower(), n)) or ok.get((repo.lower(), n)) or ok.get(("pr", n))
            review = "ok" if signed and head and head.startswith(signed) else \
                "alt" if signed or os.path.exists(os.path.join(herd, f"{s}.review.md")) else ""
            out.append((shown, n, s, review))
    return out


def v1_rows(herd, agents, lanes):
    pairs = [l.split("=", 1) for l in read_list(os.path.join(herd, "herd.map")) if "=" in l]
    queue = read_list(os.path.join(herd, "queue.txt"))
    for s, pane in pairs:
        a = agents.get(pane)
        report = os.path.exists(os.path.join(herd, f"{s}.out.md"))
        if not a and s not in queue and report:
            continue  # report written and window closed: finished, nothing left to look at
        st = read_status(os.path.join(herd, f"{s}.status.json"))
        acts = procs_in(s)
        t_age = transcript_age(a["cwd"]) if a and a.get("cwd") else None
        age = f"{int(t_age)}m" if t_age is not None and t_age >= 1 else ""
        n, m = field(st, "step", "schritt"), field(st, "of", "von")
        prog = f"{n}/{m}" if isinstance(n, int) and isinstance(m, int) else ""
        status = (a or {}).get("agent_status")
        d = {"satz": field(st, "sentence", "satz") or "", "fehlt": field(st, "missing", "fehlt") or "", "n": n, "m": m,
             "acts": acts, "jsonl": newest_jsonl(a["cwd"]) if a and a.get("cwd") else None}
        if report and (not a or status in ("idle", "done")) and not acts:
            lanes["work"].append((1, s, "✓", GREEN, "", st.get("pr") or t("done"), t("check"), d))
        elif status == "blocked":
            lanes["work"].append((0, s, "?", YEL, "", t("needs_answer"), "", {}))
        elif s in queue:
            pos = queue.index(s) + 1
            lanes["queue"].append((100 + pos, s, "◌", DIM, "", t("paused", pos=pos) if st else t("waiting", pos=pos),
                                   "", {}))
        elif not a:
            lanes["work"].append((0, s, "✕", RED, "", t("ended"), "", d))
        elif not acts and status != "working" and t_age is not None and t_age >= STILL_MIN:
            lanes["work"].append((0, s, "⚠", RED, "", f"{t('still')} {age}", "", d))
        else:
            busy = acts[0][0] if acts else ""
            lanes["work"].append((2, s, "⧗" if busy in LONG_RUNS else "●", CYAN, prog, kurz(st) or busy or t("working"),
                                  age, d))
    look = {"ok": ("✓", BLUE, t("signed")), "alt": ("…", YEL, t("in_review")), "": ("◇", DIM, t("no_review"))}
    for repo, n, s, review in v1_ready_prs(herd, agents):
        icon, col, words = look[review]
        lanes["ready"].append((10, s, icon, col, "", f"{(repo + ' ') if repo else ''}#{n} {words}", "", {}))


# ---------------------------------------------------------------------------------------------------------------
# Drawing
# ---------------------------------------------------------------------------------------------------------------

def bar(n, m, width=10, col=""):
    k = max(0, min(width, round(width * n / m))) if m else 0
    return f"{col}{'█' * k}{RST}{DIM}{'░' * (width - k)}{RST} {BLUE}{n}/{m}{RST}"


def bar_len(width=10, n=0, m=0):
    return width + 1 + len(f"{n}/{m}")


def wrap(text, width, maxlines):
    """Whole words over at most `maxlines` lines, never an ellipsis. Too long: keep the longest run of whole clauses
    that fits (cut after , ; . : or a dash); only without any clause break is it cut after the last whole word."""
    w = lambda t: textwrap.wrap(t, max(8, width), break_on_hyphens=False, break_long_words=False)
    text = " ".join(str(text).split())
    lines = w(text)
    if maxlines <= 0 or len(lines) <= maxlines:
        return lines[:max(0, maxlines)]
    cuts = [m.start() for m in re.finditer(r"[,;.:·](?=\s)|\s[–—·]\s", text)]
    for c in reversed(cuts):
        part = w(text[:c].rstrip(" ,;:–—·"))
        if part and len(part) <= maxlines:
            return part
    return lines[:maxlines]


def first_sentence(text):
    """A worker's reply shortened to its first sentence (or clause before a colon) — the feed shows the gist."""
    m = re.match(r"(.+?[.!?:])(\s|$)", text)
    return (m.group(1) if m else text).rstrip(":")


def detail_lines(row, budget, w):
    """Up to `budget` extra lines for one worker, most telling first; the step feed fills the rest. Long lines wrap."""
    _, _, _, col, _, head_text, _, d = row
    tw = w - 2
    lines = []
    label = t("missing")
    fehlt = (label + " " + re.sub(r"^(?:blocked|blockiert):\s*", t("blocked") + ", ", d["fehlt"])) \
        if d.get("fehlt") else ""
    # what is still missing is all yellow (label bold), so it never reads like the goal above it
    fehlt_paint = lambda l: (f"{BOLD}{YEL}{label}{RST}" + paint(l[len(label):], YEL)) if l.startswith(label + " ") \
        else paint(l, YEL)
    if isinstance(d.get("n"), int) and isinstance(d.get("m"), int) and d["m"]:
        # bar and "missing" share a line; the rest of it wraps below
        bl = bar_len(n=d["n"], m=d["m"])
        b = bar(d["n"], d["m"], col=col)
        part = wrap("\x00" * bl + " " + fehlt, tw, 3) if fehlt else []  # placeholder word holds the bar's place
        lines += [b + " " + fehlt_paint(part[0][bl:].lstrip())] + [fehlt_paint(p) for p in part[1:]] if part else [b]
    elif fehlt:
        lines += [fehlt_paint(l) for l in wrap(fehlt, tw, 3)]
    satz = " ".join(d.get("satz", "").split())
    head = " ".join(head_text.split())
    if head and satz.startswith(head):
        satz = satz[len(head):].lstrip(" ,;:–—")  # the header already says the first clause
    if satz:
        lines += [paint(l) for l in wrap(satz, tw, 5 if budget >= 14 else 3)]
    for words, start in (d.get("acts", []) if DETAIL else []):  # simple view: no process list
        part = wrap(f"⧗ {words} {t('since')} {int((time.time() - start) / 60)}m", tw, 2)
        lines += [f"{CYAN}⧗{RST}" + paint(part[0][1:])] + [paint(p) for p in part[1:]]
    lines = lines[:budget]
    room = budget - len(lines) if DETAIL else 0  # simple view: no step feed under the sentence
    if room > 0:
        # newest first until the room is full; the age only where it changes, wrapped lines indented under the text
        picked, used = [], 0
        for ago, text in reversed(recent_actions(d.get("jsonl"), room + 1)):
            if text == head_text:
                continue
            # at most two lines per step and never a cut-off phrase: a reply shrinks to its first sentence,
            # then to its first clause, and is left out if even that is too long
            if text.startswith("› "):
                full = [first_sentence(text[2:]), re.split(r"[,;–—(]", text[2:])[0]]
                part = next((p for p in (wrap("› " + x, tw - 5, 3) for x in full) if len(p) <= 2), [])
                if not part:
                    continue
            else:
                part = wrap(text, tw - 5, 2)
            if not part or used + len(part) > room:
                break
            picked.insert(0, (f"{int(ago)}m" if ago >= 1 else "<1m", part))
            used += len(part)
        last = None
        for age, part in picked:
            gut = f"{age:>4} " if age != last else "     "
            # replies (›) in normal italic text, tool steps dimmed; the age gutter always dim
            reply = part[0].startswith("› ")
            for i, p in enumerate(part):
                g = f"{DIM}{gut if i == 0 else '     '}{RST}"
                if reply:
                    lines.append(g + (f"{MAG}›{RST}" + paint(p[1:], ITAL) if i == 0 else paint(p, ITAL)))
                else:
                    lines.append(g + paint(p, DIM))
            last = age
    return [f"  {l}" for l in lines]


def head_lines(row, w, cont_max, show_prog=True):
    """A row's heading: icon and name in the state colour (name bold unless `thin`), ⇄ clash, the state text in plain
    text after it (continued on up to `cont_max` lines), and the dim tail (age, model·effort) at the end."""
    _, s, icon, col, prog, text, tail, d = row
    prog = prog if show_prog else ""
    name = s[:max(8, w - 8)]  # full name; only an absurdly long label is clipped
    mark = f"⇄ {d['clash']}" if d.get("clash") else ""
    weight = "" if d.get("thin") else BOLD
    left = f"{weight}{col}{icon}{RST} {weight}{col}{name}{RST} " + (f"{BLUE}{prog}{RST} " if prog else "") + \
        (f"{YEL}{mark}{RST} " if mark else "")
    room = w - len(icon) - len(name) - 2 - (len(prog) + 1 if prog else 0) - (len(mark) + 1 if mark else 0) - \
        (len(tail) + 1 if tail else 0)
    base = f"{BOLD}{col}" if d.get("bold") else ""
    # the state text follows the name when it has room, otherwise it starts on its own line
    first = (wrap(text, room, 1) or [""])[0] if room >= 14 and text else ""
    first = first if len(first) <= room else ""
    rest = " ".join(text.split()[len(first.split()):])
    out = [left + paint(first, base) + (f" {DIM}{tail}{RST}" if tail else "")]
    out += [f"  {paint(l, base)}" for l in (wrap(rest, w - 2, cont_max) if rest and cont_max > 0 else [])]
    return out


def fit(blocks, limit):
    """Rows (each a list of lines) into at most `limit` lines; what does not fit becomes one "+N more" line."""
    if sum(len(b) for b in blocks) <= limit:
        return [l for b in blocks for l in b]
    if limit < 1:
        return []
    out, shown = [], 0
    for b in blocks:
        if len(out) + len(b) > limit - 1:  # keep one line for the overflow count
            break
        out += b
        shown += 1
    return out + [f"{DIM}+{len(blocks) - shown} {t('more')}{RST}"]


def herd_dirs(anchor, given):
    listed = read_list(os.path.join(CACHE, f"{anchor.replace(':', '_')}.herds")) if anchor else []
    return list(dict.fromkeys(given + listed))


_HUMAN_CACHE = {}


def last_human_input(anchor, agents):
    """Epoch of the last message a human typed into the anchor's Claude session (typed prompt or a message queued
    mid-turn), or None. Task notifications, peer messages and scheduled wakeups do not count."""
    sess = ((agents.get(anchor) or {}).get("agent_session") or {}).get("value")
    paths = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sess}.jsonl")) if sess else []
    if not paths:
        return None
    path = paths[0]
    try:
        size = os.path.getsize(path)
    except OSError:
        return None
    hit = _HUMAN_CACHE.get(path)
    if hit and hit[0] == size:
        return hit[1]
    start = hit[0] if hit else max(0, size - 4_000_000)
    found = hit[1] if hit else None
    while True:
        with open(path, "rb") as f:
            f.seek(start)
            chunk = f.read(size - start).decode("utf-8", "replace")
        for line in chunk.split("\n")[1 if start else 0:]:
            if '"human"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            att = d.get("attachment") or {}
            human = (d.get("type") == "user" and (d.get("origin") or {}).get("kind") == "human") or \
                (att.get("type") == "queued_command" and (att.get("origin") or {}).get("kind") == "human")
            if human and d.get("timestamp"):
                e = ts_epoch(d["timestamp"])
                if e:
                    found = max(found or 0, e)
        if found or start == 0 or hit:
            break
        start = 0  # nothing in the tail: read the whole transcript once
    _HUMAN_CACHE[path] = (size, found)
    return found


def machine():
    """(load1, free RAM GB, cores)."""
    try:
        l1 = float(open("/proc/loadavg").read().split()[0])
        mem = next(int(x.split()[1]) / 1048576 for x in open("/proc/meminfo") if x.startswith("MemAvailable"))
    except (OSError, ValueError, StopIteration):
        l1, mem = 0.0, 99.0
    return l1, mem, os.cpu_count() or 1


def header(w, herds, limits, reviews, quiet):
    """One line, whatever the width: drop words until it fits."""
    l1, mem, cores = machine()
    warn = mem < 2.5 or l1 > 2 * cores
    mcol = GREEN if mem >= 5 else YEL
    path = os.environ.get("HERD_BOARD_DISK") or (herds[0] if herds and os.path.isdir(herds[0]) else os.getcwd())
    try:
        disk = shutil.disk_usage(path).free / 1e9
    except OSError:
        disk = None
    dcol = RED if disk is not None and disk < 8 else YEL if disk is not None and disk < 15 else GREEN
    k = limits.get("review") if limits and limits.get("review") is not None else reviews
    # (RAM label, disk label, input label, separator, slots key, space before the unit)
    variants = ((t("ram"), t("disk"), t("input"), " · ", "slots", " "),
                (t("ram_s"), t("disk_s"), t("input"), " · ", "slots", ""),
                (t("ram_s"), t("disk_s"), t("input"), "·", "slots_s", ""),
                ("G", "G", "✎", "·", "slots_s", ""))
    head = ""
    for ram_l, disk_l, quiet_l, sep, slots_k, sp in variants:
        parts = [f"{BOLD}{CYAN}{t('title')}{RST} {DIM}{time.strftime('%H:%M')}{RST}"]
        if limits:
            full = limits["used"] >= limits["max"] or not limits.get("ok", True)
            parts.append(f"{YEL if full else BLUE}{t(slots_k, u=limits['used'], m=limits['max'], k=k)}{RST}")
        ram = f"{RED}⚠{l1:.0f} {mem:.1f}{sp}{ram_l}{RST}" if warn else f"{mcol}{mem:.0f}{sp}{ram_l}{RST}"
        tail = [ram] + ([f"{dcol}{disk:.0f}{sp}{disk_l}{RST}"] if disk is not None else []) + \
            ([f"{YEL}{quiet_l}{quiet}{RST}"] if quiet else [])
        head = " ".join(parts) + " " + f"{DIM}{sep}{RST}".join(tail)
        if len(ANSI.sub("", head)) <= w:
            break
    return head


def _load_offen(p):
    """The "offen" list of the ask file, or None (missing, broken, not a list)."""
    try:
        with open(p, encoding="utf-8") as f:
            offen = json.load(f).get("offen")
        return offen if isinstance(offen, list) else None
    except Exception:
        return None


def _load_groups(p):
    """{gruppe: n} of the register's open_questions for every gruppe in GROUPS, or None."""
    try:
        with open(p, encoding="utf-8") as f:
            qs = json.load(f).get("open_questions")
        if not isinstance(qs, list):
            return None
        gs = [str(q.get("gruppe") or "").strip().lower() for q in qs if isinstance(q, dict)]
        return {k: gs.count(k) for k, _ in GROUPS}
    except Exception:
        return None


def ask_lines(w):
    """What waits, by group (Satie 26.11.): "? Dev n · Infra n · Expert team n: <first question …>". Dev = the ask
    file's "offen" entries (chat questions) + register open_questions with gruppe "dev", yellow/bold; Infra and
    Expert team (de: Fachteam) dim. A group with 0 is left out, all 0: no line. The short first "offen" question
    follows when there is one. Both files cached by mtime (the register is ~1.6 MB); a missing or broken file
    counts 0. Too narrow: the question is shortened, then dropped, then Infra/Expert team go on a second line."""
    offen = _by_mtime("ask", ASK_FILE, lambda p: _load_offen(p) if p else None) or []
    groups = _by_mtime("register-groups", REGISTER, lambda p: _load_groups(p) if p else None) or {}
    counts = [(k, t(key), (len(offen) if k == "dev" else 0) + (groups.get(k) or 0)) for k, key in GROUPS]
    dev = f"{BOLD}{YEL}{counts[0][1]} {counts[0][2]}{RST}" if counts[0][2] > 0 else ""
    rest = [f"{DIM}{label} {n}{RST}" for k, label, n in counts[1:] if n > 0]
    if not dev and not rest:
        return []
    sep = f" {DIM}·{RST} "
    lead = f"{BOLD}{YEL}?{RST} " if dev else f"{DIM}?{RST} "
    head = lead + sep.join(([dev] if dev else []) + rest)
    q = ""
    if offen and os.environ.get("HERD_BOARD_ASK_PREVIEW"):  # Vorschau der ersten Frage nur auf Wunsch; sonst „ama“ (Satie 26.11.)
        first = offen[0] if isinstance(offen[0], dict) else {}
        q = " ".join(str(first.get("frage") or first.get("question") or first.get("id") or "").split())
        q = q if len(q) <= ASK_SHORT else q[:ASK_SHORT].rstrip(" ,;:—-") + " …"
    vis = lambda l: len(ANSI.sub("", l))
    tail = lambda qq: f"{YEL}: {qq}{RST}" if qq.strip(" …") else ""

    def fit(base, min_q):
        """base + the question, shortened to the width; None when fewer than min_q characters of it would fit."""
        if not q or vis(base + tail(q)) <= w:
            return base + tail(q)
        qq = q[:max(0, w - vis(base) - 4)].rstrip()
        return base + tail(qq + " …") if len(qq) >= min_q else None

    one = fit(head, ASK_SHORT_MIN)
    if one is not None and vis(one) <= w:
        return [one]
    if dev and rest:  # too narrow: Dev (+ question) on the first line, Infra / Expert team on a dim second line
        two = fit(lead + dev, 1)
        return [two if two is not None and vis(two) <= w else lead + dev, sep.join(rest)]
    return [fit(head, 1) or head]


def wave_lines(w, wave, phases, limits, herd):
    """The line under the header: current wave (GO.md), how many work / wait for a fix round / are in review, and
    — when slices wait but none works — why nothing starts (memory, slots, load, unaccepted bases)."""
    n = lambda ph: len(phases.get(ph, []))
    work, fix, queued, review = n("working"), n("fix_queued"), n("queued"), n("review_running")
    parts = [f"{BOLD}{t('wave', n=wave)}{RST}"] if wave is not None else []
    parts.append(f"{CYAN if work else DIM}{t('n_work', n=work)}{RST}")
    parts += [f"{ORANGE}{t('n_fix', n=fix)}{RST}"] if fix else []
    parts += [f"{YEL}{t('n_queue', n=queued)}{RST}"] if queued else []
    parts += [f"{MAG}{t('n_review', n=review)}{RST}"] if review else []
    if (fix or queued) and not work:
        why = ""
        if limits and not limits.get("ok", True):
            why = {"memory": t("mem_lt", g=min_free_gb(herd)), "load": t("w_load")}.get(limits.get("reason"),
                                                                                       t("slots_full"))
        elif he is not None:
            waiting = [(h, s) for ph in ("queued", "fix_queued") for h, s in phases.get(ph, [])]
            bases = [(he.task_header(h, s) or {}).get("stacked_on") for h, s in waiting]
            done = {s for ph in AT_LEAST_ACCEPTED for _, s in phases.get(ph, [])}
            if waiting and all(b and b not in done for b in bases):
                why = t("base_open")
        parts += [f"{RED}{t('idle_why', why=why)}{RST}"] if why else []
    # one line; too narrow: the counts that are zero or secondary go first, the reason stays
    sep = f" {DIM}·{RST} "
    while len(parts) > 2 and len(ANSI.sub("", sep.join(parts))) > w:
        parts.pop(-2 if (fix or queued) and not work else -1)
    return [sep.join(parts)]


def render(anchor, given):
    w = max(20, shutil.get_terminal_size((66, 40)).columns - 1)
    height = shutil.get_terminal_size((66, 40)).lines - 1
    agents = herdr_agents()
    herds = herd_dirs(anchor, given)
    lanes = {"queue": [], "work": [], "ready": [], "nopr": [], "runs": []}
    notes = []
    v2 = [h for h in herds if os.path.exists(os.path.join(h, "herd.events.jsonl"))]
    v1 = [h for h in herds if h not in v2 and os.path.exists(os.path.join(h, "herd.map"))]
    limits = herd_limits(v2[0], anchor) if v2 else None
    all_evs, reviews, phases, waves = [], 0, {}, []
    if v2 and he is None:
        notes.append(f"{RED}⚠ {t('no_core')}{RST}")
    elif v2:
        per = {h: he.read(h) for h in v2}
        all_evs = [ev for evs in per.values() for ev in evs]
        merged_evs = [ev for ev in all_evs if ev.get("phase") == "merged"]
        states = {}
        for h in v2:
            st = states[h] = v2_rows(h, agents, limits, merged_evs, lanes)
            reviews += sum(1 for ev in st.values() if ev["phase"] == "review_running")
            for s, ev in st.items():
                phases.setdefault(ev["phase"], []).append((h, s))
            waves += [n for n in [current_wave(h)] if n is not None]
        lanes["runs"] = unit_rows(v2, states)
    for h in v1:
        notes.append(f"{DIM}{os.path.basename(h.rstrip('/'))}: {t('v1')}{RST}")
        v1_rows(h, agents, lanes)
    lanes["work"] += agent_rows(anchor, agents) if anchor else []

    last = last_human_input(anchor, agents) if anchor else None
    quiet = time.strftime('%H:%M', time.localtime(last)) if last and time.time() - last > 30 * 60 else ""
    top = [header(w, herds, limits, reviews, quiet)] + ask_lines(w) + \
        (wave_lines(w, max(waves) if waves else None, phases, limits, v2[0]) if v2 and he else []) + notes
    key = lambda r: (r[0], (r[7] or {}).get("sort", r[1]) if isinstance(r[7], dict) else r[1])
    for k in lanes:
        lanes[k].sort(key=key)

    def compact(rows):
        return [head_lines(r, w, 1) for r in rows]

    def lane_title(k, col):
        return f"{BOLD}{col}{t('lane_' + k)}{RST}"

    # merged today (since midnight DAY_TZ): events + the GitHub search, by repo ("api 450 451 · ui 203"), numbers
    # in green, wrapped at whole numbers; a repo's group starts a new line rather than being split when it can
    merged = {}
    for src in (merged_from_events(all_evs), merged_today()):
        for k, v in src.items():
            merged.setdefault(repo_label(k), set()).update(v)
    merged_lines = []
    if any(merged.values()):
        # title on its own line, then all repos in one flow from column 0 ("api 446 447 · ui 201"), every number
        # spelled out, wrapped at whole numbers
        words = []
        for i, k in enumerate(sorted(merged, key=lambda k: (-len(merged[k]), k))):
            words += ([f"{DIM}·{RST}"] if i else []) + [f"{DIM}{k}{RST}"] + [f"{GREEN}{n}{RST}" for n in sorted(merged[k])]
        merged_lines, cur = [f"{BOLD}{GREEN}{t('merged').strip()}{RST}"], ""
        for wd in words:
            if cur and len(ANSI.sub("", cur)) + 1 + len(ANSI.sub("", wd)) > w:
                merged_lines.append(cur)
                cur = wd if ANSI.sub("", wd) != "·" else ""
            else:
                cur = f"{cur} {wd}" if cur else wd
        merged_lines += [cur] if cur else []

    # fixed-size lanes first; the Working lane gets what is left. Over budget: queue gives way, then ready
    avail = height - len(top)
    blocks = {k: compact(lanes[k]) for k in ("queue", "ready", "nopr")}
    blocks["runs"] = [run_lines(r, w) for r in lanes["runs"]]
    work_min = 2 if lanes["work"] else 0
    size = lambda k: (1 + sum(len(b) for b in blocks[k])) if blocks[k] else 0
    foot_extra = (1 + len(merged_lines)) if merged_lines else 0
    limit = {k: size(k) for k in blocks}
    gaps = sum(1 for k in ("runs", "ready", "nopr") if blocks[k])
    over = sum(limit.values()) + foot_extra + work_min + gaps - avail
    for k in ("nopr", "queue", "runs", "ready"):
        if over <= 0:
            break
        cut = min(over, max(0, limit[k] - 2))
        limit[k] -= cut
        over -= cut

    def lane(k, col):
        return [lane_title(k, col)] + fit(blocks[k], limit[k] - 1) if blocks[k] else []

    queue = lane("queue", YEL)  # under Working (user 29.10.2026: queue below the working workers)
    runs = lane("runs", CYAN)   # merge chains and other long runs (systemd user units), under the queue
    body = []
    foot = ([""] + lane("ready", GREEN) if blocks["ready"] else []) + \
        ([""] + lane("nopr", DIM) if blocks["nopr"] else []) + ([""] + merged_lines if merged_lines else [])

    # Working lane, adaptive: the free height is shared evenly — one worker gets a full picture plus its step feed,
    # ten workers get one line each; a blank separator only when every worker has room to spare
    rows = lanes["work"]
    free = avail - len(queue) - (1 if rows and queue else 0) - len(runs) - (1 if runs and (rows or queue) else 0) \
        - len(foot) - (2 if rows else 0)
    if rows:
        body.append("")  # Leerzeile unter dem Kopf, damit er sich absetzt (Satie 26.11.)
        body.append(lane_title("work", CYAN))
        sep = 1 if free // len(rows) >= 4 else 0
        shown = rows if len(rows) <= free else rows[:max(0, free - 1)]
        per, extra = divmod(free - sep * (len(shown) - 1) - (1 if len(shown) < len(rows) else 0), len(shown)) \
            if shown else (0, 0)
        for i, row in enumerate(shown):
            budget = per + (1 if i < extra else 0) - 1
            d = row[7] if isinstance(row[7], dict) else {}
            has_bar = budget > 0 and isinstance(d.get("n"), int) and d.get("m")
            if sep and i:
                body.append("")
            hl = head_lines(row, w, 2 if budget > 6 else 1 if budget > 2 else 0, show_prog=not has_bar)
            body += hl
            body += detail_lines(row[:7] + (d,), budget - (len(hl) - 1), w)
        if len(shown) < len(rows):
            body.append(f"{DIM}+{len(rows) - len(shown)} {t('more')}{RST}")
    if queue:
        body += ([""] if rows else []) + queue
    if runs:
        body += ([""] if rows or queue else []) + runs
    busy = any(v for k, v in lanes.items() if k != "runs") or bool(merged_lines) or \
        any(r[7].get("busy") for r in lanes["runs"])
    if not busy:
        body.append(f"{DIM}{t('idle')}{RST}")
    out = top + body
    if foot:
        # the footer always shows in full: when the body runs long, the body gives way, not the footer
        out = out[:max(1, height - len(foot))]
        out += [""] * max(0, height - len(out) - len(foot)) + foot  # pinned to the bottom of the panel
    return out, busy


def frame(anchor, given):
    """One repaint. A failure is shown as a line on the board instead of ending it: a dead board pane stays open and
    every hook would open another one beside it. The panel counts as busy then, so it does not close itself."""
    try:
        return render(anchor, given)
    except Exception as e:
        w = max(20, shutil.get_terminal_size((66, 40)).columns - 1)
        msg = wrap(f"⚠ {t('draw_err')}: {type(e).__name__}: {e}", w, 3) or ["⚠ herd-board"]
        return [f"{BOLD}{CYAN}{t('title')}{RST} {DIM}{time.strftime('%H:%M')}{RST}"] + \
            [f"{RED}{l}{RST}" for l in msg], True


def live_file(anchor):
    return os.path.join(CACHE, "live", anchor.replace(":", "_"))


def is_live(anchor):
    """pid of a running board for this anchor, else None."""
    try:
        pid = open(live_file(anchor)).read().split()[0]
        if b"herd-board" in open(f"/proc/{pid}/cmdline", "rb").read():
            return pid
    except (OSError, IndexError):
        pass
    return None


def tab_panes(pane):
    """Pane ids of the tab that holds ``pane``, with their rects (via herdr's neighbor layout)."""
    try:
        r = subprocess.run(["herdr", "pane", "neighbor", "--pane", pane, "--direction", "left"],
                           capture_output=True, text=True, timeout=10)
        return {p["pane_id"]: p["rect"] for p in json.loads(r.stdout)["result"]["neighbor"]["layout"]["panes"]}
    except Exception:
        return {}


def board_in_tab(anchor):
    """pid of any running herd-board whose pane sits in the anchor's tab — started with or without
    --anchor (a hand restart without it once left two boards side by side)."""
    panes = set(tab_panes(anchor))
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            if b"herd-board" not in open(f"/proc/{pid}/cmdline", "rb").read() or int(pid) == os.getpid():
                continue
            env = dict(l.split(b"=", 1) for l in open(f"/proc/{pid}/environ", "rb").read().split(b"\0") if b"=" in l)
            if env.get(b"HERDR_PANE_ID", b"").decode() in panes:
                return pid
        except (OSError, ValueError):
            pass
    return None


def open_panel(anchor, given):
    """Split the anchor's right third (anchor keeps 2/3) and run the board there."""
    if is_live(anchor) or board_in_tab(anchor):
        return

    def herdr(*a):
        r = subprocess.run(["herdr", *a], capture_output=True, text=True, timeout=20)
        try:
            return json.loads(r.stdout)
        except ValueError:
            return {}
    res = herdr("pane", "split", "--pane", anchor, "--direction", "right", "--ratio", "0.6667",
                "--cwd", os.getcwd(), "--no-focus")
    new = res.get("result", {}).get("pane", {}).get("pane_id")
    if new:
        herdr("pane", "rename", new, t("title"))
        herdr("pane", "run", new, "clear; herd-board --anchor " + shlex.quote(anchor) +
              "".join(" " + shlex.quote(g) for g in given))


# ---------------------------------------------------------------------------------------------------------------
# Self-test (offline: herdr, gh, herd-limits and herd-clash are stubbed in-process)
# ---------------------------------------------------------------------------------------------------------------

def merged_block(lines):
    """Merged today as rendered: the title line and the indented repo lines under it, joined by newlines."""
    i = next((n for n, l in enumerate(lines) if l.startswith(t("merged").strip())), None)
    if i is None:
        return ""
    out = [lines[i]]
    for l in lines[i + 1:]:
        if not l.strip():
            break
        out.append(l)
    return "\n".join(out)


def selftest():
    """Synthetic events for every lane and computed state, the v1 fallback, malformed status/event files, overflow
    and a failing repaint. Offline: no herdr, no gh, no ~/.cache writes. Exit 0 = pass."""
    import tempfile
    g = globals()
    detail_before = g["DETAIL"]
    g["DETAIL"] = True  # most checks read the detailed rows; the simple view has its own check below
    strip = lambda ls: [ANSI.sub("", l) for l in ls]
    fails = []

    def check(name, cond):
        print(("ok: " if cond else "FAIL: ") + name)
        cond or fails.append(name)

    if he is None:
        print("FAIL: herd_events.py not importable next to herd-board")
        return 1
    now = time.time()
    iso = lambda ago_s: time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now - ago_s))
    sha = lambda c: (c * 40)[:40]
    with tempfile.TemporaryDirectory() as tmp:
        herd = os.path.join(tmp, "herd-v2")
        os.makedirs(herd)
        wt_root = os.path.join(tmp, "wt")
        evs = []

        def ev(slice_name, phases, ago=600, **last_fields):
            """Append `phases` in order (validated against herd_events.TRANSITIONS); extra fields on the last one."""
            frm = None
            for i, ph in enumerate(phases):
                assert ph in he.TRANSITIONS.get(frm, set()), f"{slice_name}: {frm} -> {ph}"
                e = {"ts": iso(ago - i), "slice": slice_name, "phase": ph, "by": "orchestrator"}
                if ph == "working":
                    e.update(pane=f"w1:{slice_name}", model="claude-opus-5-5", effort="high",
                             wt=[os.path.join(wt_root, "app", slice_name)])
                if i == len(phases) - 1:
                    e.update(last_fields)
                evs.append(e)
                frm = ph

        W, A, RR, OK, BF = (["queued", "working"], ["queued", "working", "accepted"],
                            ["queued", "working", "accepted", "review_running"],
                            ["queued", "working", "accepted", "review_running", "review_ok"],
                            ["queued", "working", "accepted", "review_running", "review_befund"])
        ev("q-one", ["queued"], pos=2)
        ev("q-two", ["queued"], pos=1)
        ev("q-stack", ["queued"], pos=3)                       # stacked_on w-run (only working) -> base reason
        ev("fx", BF + ["fix_queued"], befunde_file="fx.befunde-abc1234.md")
        ev("w-run", W)                                         # agent working -> ● O·hi, clash with w-fix
        ev("w-fix", BF + ["fix_queued", "working"])            # fix round -> ↺
        ev("w-blk", W)                                         # agent blocked -> ? first under Working
        ev("w-rep", W)                                         # out.md + idle -> reported ✓
        ev("w-gone", W, ago=3600)                              # pane gone, no report -> ✕
        ev("w-new", W, ago=5)                                  # pane not listed yet, fresh -> starting
        ev("w-still", W)                                       # idle, transcript old -> ⚠
        ev("a-one", A, prs=["app#11@" + sha("a")[:7]])        # partner a-two still working -> waits for partner
        ev("a-two", W)
        ev("rr", RR[:-1] + ["review_running", "review_befund", "fix_queued", "working", "accepted", "review_running"],
           run_id="r1", round=1)                               # the loop's own counter restarts; history says 2
        ev("rp", OK + ["review_running"], run_id="r4", round=1)  # review straight after review_ok -> re-probe
        ev("ok-api", OK, prs=["app#20@" + sha("b")], main=["app@" + sha("c")], run_id="r2")
        ev("ok-ui", OK, prs=["web#7@" + sha("d")], main=["web@" + sha("e")], run_id="r3")
        ev("st-head", OK, prs=["app#30@" + sha("f")], main=["app@" + sha("c")])        # head moved -> stale
        ev("st-main", OK, ago=7200, prs=["lib#40@" + sha("1")], main=["lib@" + sha("2")])  # merge landed after
        ev("st-mv", OK, prs=["web#8@" + sha("8")], main=["web@" + sha("9")])          # web main moved on
        ev("st-nm", OK, prs=["app#31@" + sha("b")], run_id="v1-freigabe")               # no main (migrated v1)
        ev("bf", BF, befunde_file="bf.befunde-1234abc.md")
        ev("ok-stk", OK, prs=["app#21@" + sha("b")], main=["app@" + sha("c")])  # stacked on rr -> no word yet
        ev("m-done", OK + ["merged"], ago=60, prs=["lib#41@9f9f9f9"], go="merge m-done")
        ev("pk", ["queued", "parked"], reason="not needed")
        with open(he.path(herd), "w", encoding="utf-8") as f:
            for e in evs:
                f.write(json.dumps(e) + "\n")
            f.write('{"slice": "torn", "phase": "work')          # a crash mid-write: skipped, not fatal
        for e in evs:  # every slice with a PR has its <slice>.repos (a review_ok without both is "result, no PR")
            if e.get("prs"):
                repo = PR_REF.match(str(as_list(e["prs"])[0]))[1]
                open(os.path.join(herd, f"{e['slice']}.repos"), "w").write(f"{repo} feat/{e['slice']} origin/main\n")
        for s, hdr in {"a-one": "together_with: a-two", "ok-api": "together_with: ok-ui",
                       "q-stack": "stacked_on: w-run", "ok-stk": "stacked_on: rr"}.items():
            open(os.path.join(herd, f"{s}.task.md"), "w").write(f"{hdr}\nmodel: claude-opus-5-5\n\n# task\n")
        for s in ("a-two", "ok-ui", "w-run"):
            open(os.path.join(herd, f"{s}.task.md"), "w").write("tickets: 1\n\n# task\n")
        open(os.path.join(herd, "w-rep.out.md"), "w").write("report\n")
        open(os.path.join(herd, "w-rep.status.json"), "w").write('{"pr": "app #12"}')
        open(os.path.join(herd, "w-run.status.json"), "w").write(
            '{"short": "builds the lane view", "step": 2, "of": 5, "missing": ["tests", "docs"]}')
        open(os.path.join(herd, "w-fix.status.json"), "w").write('{"kurz": "behebt Befunde"}')

        # v1 herd: herd.map and malformed status files, no events
        old = os.path.join(tmp, "herd-v1")
        os.makedirs(old)
        cases = {  # slice -> status.json as written by a worker
            "hbst-liste": '{"satz": "Board liest Listen", "schritt": 2, "von": 4, "fehlt": ["Tests", "Doku"]}',
            "hbst-null": "null",
            "hbst-array": '[1, 2]',
            "hbst-typen": '{"sentence": 7, "step": "3", "of": "x", "missing": null, "pr": ["api #12", "ui #4"]}',
        }
        open(os.path.join(old, "herd.map"), "w").write("".join(f"{s}=w0:p{i}\n" for i, s in enumerate(cases)))
        for s, body in cases.items():
            open(os.path.join(old, f"{s}.status.json"), "w").write(body)

        agents = {"w1:w-run": {"agent_status": "working", "cwd": wt_root},
                  "w1:w-fix": {"agent_status": "working", "cwd": wt_root},
                  "w1:w-blk": {"agent_status": "blocked", "cwd": wt_root},
                  "w1:w-rep": {"agent_status": "idle", "cwd": wt_root},
                  "w1:w-still": {"agent_status": "idle", "cwd": os.path.join(tmp, "still")},
                  "w1:a-two": {"agent_status": "working", "cwd": wt_root},
                  **{f"w0:p{i}": {"agent_status": "working", "cwd": wt_root} for i in range(len(cases))}}
        heads = {("app", 20): sha("b"), ("app", 21): sha("b"),
                 ("app", 30): sha("0"), ("web", 7): sha("d"), ("web", 8): sha("8"),
                 ("lib", 40): sha("1")}
        real = {k: g[k] for k in ("herdr_agents", "pr_state", "main_head", "merged_today", "find_tool",
                                  "transcript_age", "procs_in", "LANG", "ORG", "ORGS", "active_units", "CACHE",
                                  "run_procs", "ASK_FILE", "REGISTER")}
        clash_json = json.dumps({"pairs": [{"repo": "app", "slices": ["w-run", "w-fix"], "files": ["src/x.py"]}]})
        g.update(ORG="acme", ORGS=["acme"], herdr_agents=lambda: agents,
                 pr_state=lambda repo, n, cwd=None: ("OPEN", heads.get((short_repo(repo), n))),
                 main_head=lambda slug, cwd=None: {"app": sha("c"), "web": sha("e"), "lib": sha("2")}.get(
                     short_repo(slug)),
                 merged_today=lambda: {"app": [5]},
                 transcript_age=lambda cwd: 30 if cwd.endswith("still") else 0.5,
                 procs_in=lambda s, extra=(): [],
                 active_units=lambda: [],                     # no systemd: no chains (stubbed again below)
                 CACHE=os.path.join(tmp, "cache"),
                 ASK_FILE=os.path.join(tmp, "no-ask.json"), REGISTER=os.path.join(tmp, "no-register.json"),
                 # hermetic: the real files never reach the other checks
                 find_tool=lambda name: "/nonexistent/" + name)  # answers come from TOOL_CACHE below
        TOOL_CACHE.clear()
        TOOL_CACHE[("limits", herd)] = (now + 3600, parse_limits(
            "slots 4/6 (1 review), free 9100 MB (min 8000), load 3.20 (max 40)", 0))
        TOOL_CACHE[("clash", herd)] = (now + 3600, parse_clash(json.loads(clash_json)))
        os.environ.update(COLUMNS="100", LINES="90")
        try:
            check("herd_events.state skips the torn line", "torn" not in he.state(herd) and
                  he.state(herd)["fx"]["phase"] == "fix_queued")
            check("non-object status is {}", read_status(os.path.join(old, "hbst-null.status.json")) == {}
                  and read_status(os.path.join(old, "hbst-array.status.json")) == {})
            check("fields bent into the contract",
                  read_status(os.path.join(old, "hbst-typen.status.json")) ==
                  {"sentence": "7", "step": 3, "of": None, "missing": "", "pr": "api #12, ui #4"})
            check("model tag", model_tag("claude-opus-5-5", "high") == "O·hi" and model_tag("fable-5.1", "medium")
                  == "F·md" and model_tag("claude-sonnet-5-5", "") == "S" and model_tag(None, None) == "")
            lim_json = json.dumps({"ok": False, "used": 2, "max": 6, "review": 1, "free_mb": 100,
                                   "min_free_mb": 8000, "load": 1.0, "max_load": 40,
                                   "reasons": ["only 100 MB free (min 8000)"]})
            check("limits json + text + unmeasurable",
                  parse_limits(lim_json, 1) == {"used": 2, "max": 6, "review": 1, "ok": False, "reason": "memory"}
                  and parse_limits("slots 6/6 (0 review), free 9000 MB (min 8000), load 1.00 (max 40)\n"
                                   "no slot: all 6 slots used", 1)["reason"] == "slot"
                  and parse_limits("slots 2/6 (0 review), free 9000 MB (min 8000), load 50.00 (max 40)", 1)["reason"]
                  == "load" and parse_limits("nonsense", 0) is None and parse_limits(lim_json, 2) is None)
            real_clash = {"pairs": [{"repo": "app", "slices": ["x", "y"], "files": ["a.py"], "relation": None}],
                          "by_slice": {"x": [{"other": "y"}], "y": [{"other": "x"}]},
                          "changed": {"app": {"x": ["a.py"], "y": ["a.py"], "z": ["b.py"]}}, "skipped": []}
            check("clash shapes", parse_clash(real_clash) == {"x": {"y"}, "y": {"x"}}
                  and parse_clash({"app": [{"slices": ["p", "q", "r"]}]})["p"] == {"q", "r"}
                  and parse_clash({"clashes": [{"a": "x", "b": "y"}]}) == {"x": {"y"}, "y": {"x"}}
                  and parse_clash("junk") == {})
            for lang in ("de", "en"):
                g["LANG"] = lang
                out, busy = render("", [herd, old])
                text = "\n".join(strip(out))
                lines = strip(out)
                row = lambda s: next((l for l in lines if re.match(rf"^\S+ {re.escape(s)}(\s|$)", l)), "")
                order = [next((i for i, l in enumerate(lines) if l == t("lane_" + k)), -1)
                         for k in ("queue", "work", "ready")]
                check(f"[{lang}] all three lanes in order (Working, Queue, Ready)", busy and -1 not in order
                      and order[1] < order[0] < order[2])
                ready_at = next((i for i, l in enumerate(lines) if l.startswith("✓ ok-api+ok-ui")), -1)
                check(f"[{lang}] clean package: rev'd ✓ + merge word under Ready to merge",
                      order[2] < ready_at and f"{t('reviewed')} ✓" in lines[ready_at]
                      and t("word", w="merge ok-api") in text and "✓✓" not in text)
                check(f"[{lang}] blocked slice first under Working, yellow ?", "? w-blk" in row("w-blk") and
                      order[1] < lines.index(row("w-blk")) < order[0])
                check(f"[{lang}] header slots, no you-counter", t("slots", u=4, m=6, k=1) in lines[0]
                      and "du:" not in lines[0] and "you:" not in lines[0])
                q = [l.split()[1] for l in lines[order[0] + 1:order[2]] if l[:1] and l[:1] in "!◌"]
                check(f"[{lang}] queue: fix first, then by pos", q == ["fx", "q-two", "q-one", "q-stack"])
                check(f"[{lang}] fix row + base reason", t("fix_queued", pos=1) in row("fx")
                      and t("w_base_q", b="w-run") in row("q-stack"))
                check(f"[{lang}] working ● with tag + clash", row("w-run").startswith("● w-run") and
                      "O·hi" in row("w-run") and "⇄ w-fix" in row("w-run"))
                check(f"[{lang}] fix round ↺", row("w-fix").startswith("↺ w-fix"))
                check(f"[{lang}] reported ✓", row("w-rep").startswith("✓ w-rep") and t("checking") in row("w-rep"))
                check(f"[{lang}] gone ✕ / starting / still ⚠", row("w-gone").startswith("✕") and
                      t("starting") in row("w-new") and row("w-still").startswith("⚠"))
                check(f"[{lang}] progress bar + missing", "█" in text and f"{t('missing')} tests, docs" in text)
                check(f"[{lang}] accepted waits for partner", row("a-one+a-two").startswith("◇") and
                      t("w_partner", x="a-two") in row("a-one+a-two"))
                check(f"[{lang}] review running round 2/3 from the history", t("review_round", n=2) in row("rr"))
                check(f"[{lang}] review after review_ok reads as re-probe", t("reprobe") in row("rp"))
                check(f"[{lang}] reviewed but base unmerged: no merge word", row("ok-stk").startswith("✓ ok-stk")
                      and t("w_base", b="rr") in row("ok-stk") and order[2] < lines.index(row("ok-stk")))
                check(f"[{lang}] stale by PR head", row("st-head").startswith("⟳") and
                      t("stale_head", ref="app#30") in row("st-head"))
                # main moved under a conflict-free package is routine: grey, "re-probe due" while no chain runs
                check(f"[{lang}] stale by a later merge reads as routine", row("st-main").startswith("⟳") and
                      t("main_due") in row("st-main") and t("stale") not in row("st-main"))
                check(f"[{lang}] stale by main moved reads as routine", row("st-mv").startswith("⟳") and
                      t("main_due") in row("st-mv"))
                check(f"[{lang}] stale without a recorded main", row("st-nm").startswith("⟳") and
                      t("stale_nomain", repo="app") in row("st-nm"))
                check(f"[{lang}] findings !", row("bf").startswith("!") and "bf.befunde-1234abc.md" in row("bf"))
                mb = merged_block(lines)
                check(f"[{lang}] merged today from events + search", " 5" in f" {mb} " and " 41" in f" {mb} ")
                check(f"[{lang}] parked and merged slices hidden", not row("pk") and not row("m-done"))
                check(f"[{lang}] v1 fallback line + rows", t("v1") in text and "hbst-liste" in text and
                      f"{t('missing')} Tests, Doku" in text)
            g["LANG"] = "de"
            g["DETAIL"] = False
            simple = "\n".join(strip(render("", [herd, old])[0]))
            check("simple view: PR numbers without sha; no tags, overlaps or merge word; rev'd ✓ stays",
                  "O·hi" not in simple and "⇄" not in simple and "@" + sha("b")[:7] not in simple
                  and "app #20" in simple and t("word", w="merge ok-api") not in simple
                  and f"{t('reviewed')} ✓" in simple)
            g["DETAIL"] = True
            os.environ.update(LINES="16")
            out, busy = render("", [herd, old])
            lines = strip(out)
            check("small panel: within height, merge word kept, overflow counted",
                  len(out) <= 15 and any(t("word", w="merge ok-api") in l for l in lines) and any(f" {t('more')}" in l for l in lines))
            check("small panel: footer pinned", any(l.startswith(t("merged").strip()) for l in lines[-3:]))
            os.environ.update(LINES="90")
            newer_checks(herd, tmp, heads, sha, iso, now, strip, check)
            ask_checks(herd, tmp, strip, check)
            for s in cases:  # reports written: the v1 footer reads every status file's "pr"
                open(os.path.join(old, f"{s}.out.md"), "w").write("done\n")
            agents.update({f"w0:p{i}": {"agent_status": "idle", "cwd": wt_root} for i in range(len(cases))})
            check("v1 ready-to-merge with malformed status files", isinstance(v1_ready_prs(old, agents), list))
            # malformed event fields: must render, never crash
            with open(he.path(herd), "a", encoding="utf-8") as f:
                f.write("\n" + json.dumps({"ts": "junk", "slice": "odd", "phase": "review_ok", "prs": "app#x",
                                           "main": 5, "round": "x"}) + "\n")
                f.write(json.dumps({"ts": iso(1), "slice": "odd2", "phase": "review_running", "round": "zwei",
                                    "prs": None}) + "\n")
                f.write(json.dumps({"ts": iso(1), "slice": "odd3", "phase": "working", "pane": 7, "wt": "x"}) + "\n")
            try:
                out, busy = render("", [herd])
                check("malformed event fields render", busy and "odd" in "\n".join(strip(out)))
            except Exception as e:
                check(f"malformed event fields render ({type(e).__name__}: {e})", False)
            g["render"] = lambda *a: 1 / 0
            try:
                out, busy = frame("", [herd])
                check("a failing repaint shows an error line",
                      busy and any("ZeroDivisionError" in l for l in strip(out)))
            finally:
                g["render"] = render_impl
            wide = f"{DIM}herd-2010: v1 herd — herd-recover migrates it{RST}  🤖 cut check"
            cut = [ANSI.sub("", clip(wide, n)) for n in (38, 20, 50)]
            check("clip keeps every line inside the panel width (colour codes free, emoji two columns)",
                  [sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in v) for v in cut] == [38, 20, 50]
                  and clip("abc", 10) == "abc")
        finally:
            g.update(real)
            TOOL_CACHE.clear()
    g["DETAIL"] = detail_before
    print("herd-board selftest: " + (f"FAILED ({len(fails)})" if fails else "OK"))
    return 1 if fails else 0


def newer_checks(herd, tmp, heads, sha, iso, now, strip, check):
    """Self-test cases for the 26.11. additions: result without PR, conflict vs routine stale, merge chains, merge
    word from GO.md, dead subagent registrations, the wave line and Merged today by repo since midnight Berlin."""
    g = globals()
    g["LANG"] = "de"
    with open(he.path(herd), "a", encoding="utf-8") as f:
        for e in ({"slice": "ev-only", "prs": None, "note": "Messung"},
                  {"slice": "kf", "prs": ["app#50@" + sha("5")], "main": ["app@" + sha("c")]},
                  {"slice": "ok-solo", "prs": ["app#60@" + sha("6")], "main": ["app@" + sha("c")]}):
            for i, ph in enumerate(["queued", "working", "accepted", "review_running", "review_ok"]):
                ev = {"ts": iso(900 - i), "slice": e["slice"], "phase": ph, "by": "orchestrator"}
                if ph == "review_ok":
                    ev.update({k: v for k, v in e.items() if v is not None and k != "slice"})
                f.write(json.dumps(ev) + "\n")
    heads.update({("app", 50): sha("5"), ("app", 60): sha("6")})
    open(os.path.join(herd, "ev-only.repos"), "w").write("app eval/ev-only origin/main\n")
    open(os.path.join(herd, "ev-only.status.json"), "w").write('{"pr": "kein PR (Messung)"}')
    for s_ in ("kf", "ok-solo"):
        open(os.path.join(herd, f"{s_}.repos"), "w").write(f"app feat/{s_} origin/main\n")
    # kf: the last re-probe ended in a conflict; old: a conflict that a later run resolved
    open(os.path.join(herd, "reprobe-kf.log"), "w").write(
        "== kf\n   sauber (rot auf main und mit PR gleich: 0)\n== kf\n   KONFLIKT: src/x.py \n"
        "kein review_ok (Exit 3) — Log: reprobe-kf.log\n")
    open(os.path.join(herd, "reprobe-old.log"), "w").write("   KONFLIKT: a.py\n   sauber (rot auf main und mit PR gleich: 0)\n")
    open(os.path.join(herd, "reprobe-gone.log"), "w").write("merge ok\nKONFLIKT im Kopf erwähnt\n")
    open(os.path.join(herd, "merge-welle3.gescheitert"), "w").write("gone\n")
    check("reprobe verdicts: last KONFLIKT, resolved later, gescheitert + KONFLIKT, log older than review_ok",
          reprobe_conflict(herd, "kf") and not reprobe_conflict(herd, "old") and reprobe_conflict(herd, "gone")
          and not reprobe_conflict(herd, "kf", since=time.time() + 3600) and not reprobe_conflict(herd, "none"))
    # GO.md: a merge word for ok-solo in one sentence, a refusal for st-mv in the next; the last wave line says 4
    open(os.path.join(herd, "GO.md"), "w").write(
        "- 2026-11-25T11:18Z „merge“. = MERGE-Wort für app #60 (ok-solo, Kopf 6666666) nach reprobe; "
        "START-Go für Welle 3 (Nr. 1). Kein Merge-Wort für st-mv.\n"
        "- 2026-11-25T23:15Z „go“. = START-Go für Welle 4 (ok-api, ok-ui). KEIN Merge-Wort für Welle 4 (ok-api).\n"
        "- 2026-11-25T23:20Z „hm“. KEIN ausdrückliches Merge-Wort für ok-ui, Welle 2.\n")
    check("merge word heuristic", has_merge_word(herd, "ok-solo") and not has_merge_word(herd, "st-mv")
          and not has_merge_word(herd, "ok-api") and not has_merge_word(herd, "ok") and current_wave(herd) == 2)
    g["active_units"] = lambda: []
    lines = strip(render("", [herd])[0])
    row = lambda s_: next((l for l in lines if re.match(rf"^\S+ {re.escape(s_)}(\s|$)", l)), "")
    check("no merge word yet: ⏸ waits for it, merge word ✓ where given, no chain: re-probe due",
          row("ok-api+ok-ui").startswith("⏸") and t("go_wait") in row("ok-api+ok-ui")
          and row("ok-solo").startswith("✓") and t("main_due") in row("st-mv"))
    with open(os.path.join(herd, "GO.md"), "a", encoding="utf-8") as f:
        f.write("- 2026-11-26T05:49Z Nutzer: „merge welle 4“. = START-Go und MERGE-Wort für Welle 4 (ok-api, ok-ui, "
                "Welle 3 Rest) je Slice nach review_ok.\n")
    gv = os.path.join(tmp, "gv")
    gv_cmd = lambda nn: ('/bin/bash -c H=x; until herd-phase $H --state | grep -qE "^q-one +merged"; do sleep 60; done; '
                         f"exec {gv}/runde.sh --runde {nn} --stand main")
    g["active_units"] = lambda: [{"unit": "merge-welle3", "since": now - 600}, {"unit": "merge-vorfahrt", "since": now - 9e5},
                                 {"unit": "gv-runde-05", "since": now - 9000, "cmd": gv_cmd("05")},
                                 {"unit": "gv-runde-06", "since": now - 60, "cmd": gv_cmd("06")},
                                 {"unit": "recalc-x", "since": now - 900}]
    hm = lambda ago: time.strftime("%H:%M", time.gmtime(now - ago))
    # the chain: slice list in its script, at kf for 12 min; earlier runs of the suite kind took 20, 25 and 30 min
    open(os.path.join(herd, "merge-welle3.sh"), "w").write('H=x\nW8="m-done kf ok-solo w-fix rr gone"\n')
    open(os.path.join(herd, "merge-welle3.log"), "w").write(f"== ok-api {hm(5000)}Z\nfertig ok-api {hm(4990)}Z\n"
                                                           f"== kf {hm(720)}Z\n== kf {hm(720)}\n")
    open(os.path.join(herd, "merge-welle2.log"), "w").write("".join(
        f"== {s_} {hm(a)}Z\nfertig {s_} {hm(a - d * 60)}Z\n"
        for s_, a, d in (("ok-api", 9000, 20), ("st-head", 7000, 25), ("st-nm", 5000, 30))))
    g["run_procs"] = lambda: [(["bash", "/x/reprobe.sh", herd, "kf"], now - 600)]
    _FILE_CACHE.clear()
    lines = strip(render("", [herd])[0])
    row = lambda s_: next((l for l in lines if re.match(rf"^\S+ {re.escape(s_)}(\s|$)", l)), "")
    lane_at = lambda k: next((i for i, l in enumerate(lines) if l == t("lane_" + k)), -1)
    check("result without PR: own grey lane, branch shown, not under Ready to merge",
          lane_at("nopr") > lane_at("ready") > -1 and row("ev-only").startswith("○ ev-only")
          and t("nopr") in row("ev-only") and "eval/ev-only" in row("ev-only")
          and lines.index(row("ev-only")) > lane_at("nopr"))
    check("merge conflict: red ✕, worker needed", row("kf").startswith("✕ kf") and t("conflict") in row("kf"))
    check("routine stale with a chain running: chain re-probes", t("main_routine") in row("st-mv"))
    check("merge word ✓ / ⏸ per package", row("ok-solo").startswith("✓") and t("go_ok") in row("ok-solo")
          and row("ok-api+ok-ui").startswith("✓") and t("go_ok") in row("ok-api+ok-ui"))
    with open(os.path.join(herd, "GO.md"), "a", encoding="utf-8") as f:
        f.write("- 2026-11-26T06:00Z Korrektur: Welle 5 (ok-solo) läuft neu. KEIN Merge-Wort für Welle 5.\n")
    # gv round 05: case a done after 46.5 min, b running for 10 min, c to come; round 06 still waits for q-one
    os.makedirs(os.path.join(gv, "runden", "05"))
    hms = lambda ago: time.strftime("%H:%M:%S", time.gmtime(now - ago))
    open(os.path.join(gv, "runden", "05", "runde.log"), "w").write(
        f"[{hms(7800)}Z] Runde 05, Fälle: a b c, parallel 1, Speicher frei 1 MB\n"
        f"[{hms(7790)}Z] Fall a (lernen): Treiber startet\n[{hms(5000)}Z] Fall a: Vergleich beendet mit Code 0\n"
        f"[{hms(600)}Z] Fall b (lernen): Treiber startet\n")
    # recalc-x: the first project is done, the second has run for 3 min
    open(os.path.join(herd, "recalc-x.sh"), "w").write(
        'for p in demo_kronos_merzdorf gs_ga_ber_drv_ruhrstrasse_bauteil_d_2_etagen_afb; do\n'
        '  gst-staging-prep "$p" neu-berechnen; done\n')
    open(os.path.join(herd, "recalc-x.log"), "w").write(
        f"main abc {hm(900)}Z, warte auf Staging\nStaging auf abc {hm(800)}Z\n== demo_kronos_merzdorf {hm(700)}Z\n"
        f"running | enrich | …\ndone | done | Fertig: 13 Zeilen\n"
        f"== gs_ga_ber_drv_ruhrstrasse_bauteil_d_2_etagen_afb {hm(180)}Z\nrunning | populate | …\n")
    lines = strip(render("", [herd])[0])

    def block(label):
        """A Chains & runs row with its continuation lines, joined."""
        i = next((i for i, l in enumerate(lines) if re.match(rf"^[»▸] {re.escape(label)}( |$)", l)), None)
        if i is None:
            return ""
        out = [lines[i]]
        for l in lines[i + 1:]:
            if not l.startswith("  "):
                break
            out.append(l.strip())
        return " ".join(out)
    ch = block(t("u_wave", n=3))
    check("chain row: n/m merged, slice now + test run n/~median min, next review_ok, waiting with reason, failed "
          "with reason",
          ch.startswith("» " + t("u_wave", n=3) + " · ") and t("n_merged", n=1, m=6) in ch
          and re.search(r"jetzt kf:? Testlauf 1[23]/~25 min", ch) is not None and t("next", s="ok-solo") in ch
          and t("wait_for", x=f"w-fix ({t('r_fix')}), rr ({t('r_review')})") in ch
          and t("failed_list", x="gone (KONFLIKT)") in ch and lane_at("runs") > -1)
    check("merge-vorfahrt hidden while it holds nothing", not block(t("u_vorfahrt")))
    gvr = block(t("u_gv", n=5))
    check("gv round: case i/n, since, ETA from the mean case length",
          gvr.startswith("▸ " + t("u_gv", n=5)) and t("gv_case", i=2, n=3, f="b") in gvr
          and t("gv_since", d="2 h 10") in gvr and "fertig ~" in gvr)
    check("gv round before its log: waits for the gate slice", t("gate", s="q-one") in block(t("u_gv", n=6)))
    rc = block(t("u_recalc_st"))
    check("recalc: project done / running with minutes, long slug shortened",
          t("rc_done", p="demo_kronos_merzdorf") in rc and re.search(r"ruhrstrasse_bauteil läuft \([34] min\)", rc))
    open(os.path.join(herd, "merge-vorfahrt.angehalten"), "w").write(f"{os.getpid()}\n999999999\n")
    g["run_procs"] = lambda: [(["/usr/bin/python3", "/x/herd-merge", ".", "kf", "--go", "w"], now - 30)]
    lines = strip(render("", [herd])[0])
    check("merge step: herd-merge running -> mergt", t("now_at", s="kf", what=t("step_merge")) in block(t("u_wave", n=3)))
    check("merge-vorfahrt shown while it holds live test runs, names the chain's slice",
          t("vf_holds", n=1, s="kf") in block(t("u_vorfahrt")))
    g["run_procs"] = lambda: [(["bash", "/x/suite-slot.sh", "bash", "/x/reprobe.sh", herd, "kf"], now - 120)]
    lines = strip(render("", [herd])[0])
    check("slot step: reprobe waits for a test slot", t("step_slot", d="2 min") in block(t("u_wave", n=3)))
    check("durations in plain words", dur(720) == "12 min" and dur(7800) == "2 h 10" and dur(3900) == "1 h 05")
    g["run_procs"] = lambda: []
    check("wave line: largest N of the last wave line + counts", t("wave", n=5) in lines[1]
          and t("n_work", n=0).split()[1] in lines[1])
    wl = lambda lim, ph: ANSI.sub("", wave_lines(200, 5, ph, lim, herd)[0])
    q = {"queued": [(herd, "q-one")]}
    check("idle reason: memory threshold, slots full; none while a worker runs",
          t("mem_lt", g=min_free_gb(herd)) in wl({"ok": False, "reason": "memory", "used": 1, "max": 6}, q)
          and t("slots_full") in wl({"ok": False, "reason": "slot", "used": 6, "max": 6}, q)
          and t("idle_why", why="").strip(": ") not in wl(None, q)
          and t("idle_why", why="").strip(": ") not in wl({"ok": False, "reason": "slot"}, dict(q, working=[(herd, "w")])))
    # dead subagent registrations go, live ones stay
    reg = os.path.join(g["CACHE"], "x_y.agents")
    os.makedirs(reg, exist_ok=True)
    for name, age_min in (("dead", 200), ("live", 1)):
        tr = os.path.join(tmp, f"agent-{name}.jsonl")
        open(tr, "w").write("{}\n")
        os.utime(tr, (now - age_min * 60, now - age_min * 60))
        open(os.path.join(reg, f"agent-{name}.jsonl"), "w").write(f"{name} agent\n{tr}\n")
    labels = [r[1] for r in agent_rows("x:y")]
    check("dead subagent (> AGENT_DEAD_MIN) unregistered, live one shown",
          labels == ["live agent"] and not os.path.exists(os.path.join(reg, "agent-dead.jsonl")))
    # merged today: since midnight Europe/Berlin, grouped by repo
    mid = day_start()[0]
    evs = [{"phase": "merged", "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(mid + d)), "prs": [f"gst-gen-api#{n}"]}
           for d, n in ((-120, 1), (120, 2))]
    check("merged today counts from midnight Berlin", list(merged_from_events(evs).values()) == [[2]])
    check("repo labels", repo_label("gst-gen-api") == "api" and repo_label("artenschutz-ingest") == "ingest"
          and repo_label("acme/web") == "web")
    ml = merged_block(lines)
    check("merged today: title alone, repos flow from column 0", re.search(r"\bapp 5\b", ml) is not None
          and "lib 41" in ml and "·" in ml and ml.split("\n")[0].strip() == t("merged").strip())
    g["active_units"] = lambda: []


def ask_checks(herd, tmp, strip, check):
    """Self-test for the "waits, by group" line (Satie 26.11.): Dev = chat questions + register gruppe dev, Infra and
    Expert team / Fachteam from the register, zero groups left out, short first question, no person names, a
    narrow panel, nothing waiting, broken files."""
    os.environ["HERD_BOARD_ASK_PREVIEW"] = "1"  # die Prüfungen decken die Vorschau mit ab; im Betrieb ist sie aus
    g = globals()
    ask, reg = os.path.join(tmp, "beim-nutzer.json"), os.path.join(tmp, "register.json")
    g.update(ASK_FILE=ask, REGISTER=reg)
    long_q = "3× L = 0 in Merzdorf (Großes Mausohr, Bechsteinfledermaus, Braunes Langohr) zurücksetzen?"
    json.dump({"offen": [{"id": "a", "seit": "2026-11-26", "frage": long_q},
                         {"id": "b", "seit": "2026-11-26", "frage": "Leiste auf Deutsch?"}]}, open(ask, "w"))
    json.dump({"open_questions": [{"id": "q-1", "gruppe": "dev", "owner": "Satie"},
                                  {"id": "q-2", "gruppe": " Dev ", "owner": "Mariusz"},
                                  {"id": "q-3", "gruppe": "infra", "owner": "Mariusz (Satie 05.11.)"},
                                  {"id": "q-4", "gruppe": "fachteam", "owner": "Yvonne"},
                                  {"id": "q-5", "gruppe": "fachteam"}, {"id": "q-6", "owner": "Mariusz"},
                                  "junk"]}, open(reg, "w"))
    names = lambda ls: any(n in l for l in ls for n in ("Mariusz", "Satie", "Yvonne"))
    try:
        for lang in ("de", "en"):
            g["LANG"] = lang
            lines = strip(render("", [herd])[0])
            want = f"? Dev 4 · Infra 1 · {t('g_fach')} 2: 3× L = 0 in Merzdorf"
            check(f"[{lang}] group line right under the header: Dev 4 (2 chat + 2 register), Infra 1, "
                  f"{t('g_fach')} 2, short first question …, no person names",
                  len(lines) > 1 and lines[1].startswith(want) and lines[1].endswith(" …") and long_q not in lines[1]
                  and not names(lines[1:3]))
        g["LANG"] = "de"
        raw = ask_lines(200)[0]
        check("only the Dev part is yellow, Infra/Fachteam dim",
              f"{BOLD}{YEL}Dev 4{RST}" in raw and f"{DIM}Infra 1{RST}" in raw and f"{DIM}Fachteam 2{RST}" in raw)
        out = ask_lines(40)
        check("narrow: Infra/Fachteam on their own dim line, both within width",
              len(out) == 2 and all(len(ANSI.sub("", l)) <= 40 for l in out)
              and ANSI.sub("", out[0]).startswith("? Dev 4") and ANSI.sub("", out[1]) == "Infra 1 · Fachteam 2")
        json.dump({"offen": [{"id": "a", "frage": "Kurz?"}]}, open(ask, "w"))
        check("one chat question: short question whole",
              ANSI.sub("", ask_lines(200)[0]) == "? Dev 3 · Infra 1 · Fachteam 2: Kurz?")
        json.dump({"offen": []}, open(ask, "w"))
        json.dump({"open_questions": [{"id": "q-3", "gruppe": "infra"}, {"id": "q-6", "owner": "Mariusz"}]},
                  open(reg, "w"))
        out = ask_lines(100)
        check("no chat question, only Infra: groups with 0 left out, no question, all dim",
              [ANSI.sub("", l) for l in out] == ["? Infra 1"] and YEL not in "".join(out))
        json.dump({"open_questions": [{"id": "q-6", "owner": "Mariusz"}]}, open(reg, "w"))
        check("nothing waiting in any group: no line", ask_lines(100) == [])
        open(ask, "w").write("{broken")
        open(reg, "w").write("[]")
        check("broken / foreign files: no line, no crash", ask_lines(100) == [])
    finally:
        g["LANG"] = "de"


render_impl = render


def main():
    args = sys.argv[1:]
    if args[:1] in (["--help"], ["-h"]):
        print(__doc__.strip())
        return 0
    if args[:1] == ["--selftest"]:
        return selftest()
    anchor = os.environ.get("AGENT_PANE_ANCHOR", "")
    if "--anchor" in args:
        i = args.index("--anchor")
        if i + 1 >= len(args):
            print("herd-board: --anchor needs a pane id", file=sys.stderr)
            return 2
        anchor = args[i + 1]
        del args[i:i + 2]
    if args[:1] == ["--open"]:
        if anchor:
            open_panel(anchor, args[1:])
        return 0
    once = "--once" in args
    args = [a for a in args if a != "--once"]
    unknown = [a for a in args if a.startswith("-")]
    if unknown:
        print(f"herd-board: unknown option {unknown[0]} (see --help)", file=sys.stderr)
        return 2
    given = [os.path.abspath(a) for a in args]
    if once:
        out, _ = frame(anchor, given)
        cols = max(20, shutil.get_terminal_size((66, 40)).columns - 1)
        print("\n".join(clip(l, cols) for l in out))
        return 0
    me = os.environ.get("HERDR_PANE_ID")
    if not anchor and me:
        # started by hand without --anchor: the anchor is the pane at the tab's top left (the orchestrator),
        # so the board registers as live, shows the subagents, and the hook opens no second one
        rects = tab_panes(me)
        left = [p for p, r in rects.items() if p != me and r.get("x") == 0 and r.get("y") == 0]
        anchor = left[0] if left else ""
    if anchor:
        os.makedirs(os.path.dirname(live_file(anchor)), exist_ok=True)
        open(live_file(anchor), "w").write(f"{os.getpid()} {me or ''}\n")
    sys.stdout.write("\033[?25l")  # hide cursor
    quiet_since = time.time()
    try:
        while True:
            out, busy = frame(anchor, given)
            rows = shutil.get_terminal_size((66, 40)).lines
            cols = max(20, shutil.get_terminal_size((66, 40)).columns - 1)
            sys.stdout.write("\033[H" + "\n".join(clip(l, cols) + "\033[K" for l in out[:rows - 1]) + "\033[J")
            sys.stdout.flush()
            if busy:
                quiet_since = time.time()
            elif me and time.time() - quiet_since > IDLE_CLOSE_MIN * 60:
                if anchor and os.path.exists(live_file(anchor)):
                    os.unlink(live_file(anchor))
                subprocess.run(["herdr", "pane", "close", me], capture_output=True)
                return 0
            time.sleep(5)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
