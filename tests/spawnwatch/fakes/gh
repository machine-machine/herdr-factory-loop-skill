#!/usr/bin/env python3
"""Fake gh: `gh pr view N [-R slug] --json ...` answers from $FAKE_GH_PRS ({"slug#n": {...}}), calls logged."""
import json, os, sys
args = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
prs = json.load(open(os.environ["FAKE_GH_PRS"])) if os.path.exists(os.environ.get("FAKE_GH_PRS", "")) else {}
if args[:2] == ["pr", "view"]:
    slug = args[args.index("-R") + 1] if "-R" in args else "cwd:" + os.path.basename(os.getcwd())
    pr = prs.get(f"{slug}#{args[2]}")
    if pr is None:
        print("no such PR", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(pr))
    sys.exit(0)
sys.exit(1)
